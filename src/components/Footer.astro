---
// Footer.astro — Global footer with newsletter, links, contact info
---
<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">

      <div class="footer-brand" data-reveal>
        <a href="/" class="site-logo" aria-label="Cent Edge Consulting - Home">
          <img src="/images/centedge_logo.png" alt="Cent Edge Consulting" class="site-logo-img footer-logo-img" />
        </a>
        <p class="footer-tagline">
          Smart Factory | Manufacturing Excellence | Profitable Results<br>
          India's specialist apparel manufacturing consultancy - helping garment factories improve efficiency,
          quality and profitability since 2002.
        </p>
        <div class="footer-social">
          <a href="https://www.linkedin.com/company/82111533/admin/dashboard/" class="social-link" target="_blank"
            rel="noopener noreferrer" aria-label="Cent Edge on LinkedIn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z" />
              <circle cx="4" cy="4" r="2" />
            </svg>
          </a>
        </div>
      </div>

            <nav class="footer-col" aria-label="Solutions navigation" data-reveal data-delay="100">
        <h4>Solutions</h4>
        <ul class="footer-links">
          <li><a href="/solutions/apparel-factory-setup-consulting/">Factory Setup</a></li>
          <li><a href="/solutions/lean-manufacturing/">Lean Manufacturing</a></li>
          <li><a href="/solutions/smart-factory/">Smart Factory</a></li>
          <li><a href="/solutions/industrial-engineering/">Industrial Engineering</a></li>
        </ul>
      </nav>

      <nav class="footer-col" aria-label="Company navigation" data-reveal data-delay="200">
        <h4>Company</h4>
        <ul class="footer-links">
          <li><a href="/">Home</a></li>
          <li><a href="/about/">About Us</a></li>
          <li><a href="/success-stories/">Success Stories</a></li>
          <li><a href="/insights/">Insights</a></li>
          <li><a href="/contact/">Contact Us</a></li>
          <li><a href="https://www.linkedin.com/company/82111533/admin/dashboard/" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        </ul>
      </nav>

      <div class="footer-col footer-contact-col" data-reveal data-delay="300">
        <h4>Contact</h4>
        <address class="footer-address">
          <p>Salarpuria Symbiosis,<br>Bannerghatta Main Road,<br>Bangalore - 560076,<br>Karnataka, India</p>
          <br>
          <a href="tel:+919901422066">+91-9901422066</a><br>
          <a href="mailto:connect@centedge.co.in">connect@centedge.co.in</a><br>
          <a href="https://wa.me/919901422066" target="_blank" rel="noopener noreferrer">WhatsApp</a>
        </address>

        <div class="footer-newsletter" style="margin-top: 1.5rem;">
          <h4>Get Industry Insights</h4>
          <form class="newsletter-form" action="https://formspree.io/f/placeholder" method="POST" novalidate>
            <input type="email" name="email" placeholder="Your email address" required aria-label="Email address">
            <button type="submit" class="btn btn-primary btn-sm">Subscribe</button>
          </form>
        </div>
      </div>

    </div>

    <div class="footer-bottom">
      <div class="footer-copyright-row">
        <p class="footer-copyright" style="margin: 0;">&copy; <time datetime="2026">2026</time> Cent Edge Consulting Pvt Ltd. All rights reserved.</p>
        <span class="footer-tagline-text">Smart Factory | Manufacturing Excellence | Profitable Results</span>
      </div>
      <nav class="footer-bottom-links" aria-label="Legal navigation">
        <a href="/privacy-policy/">Privacy Policy</a>
        <a href="/terms-of-use/">Terms of Use</a>
        <a href="/disclaimer/">Disclaimer</a>
        <a href="/cookie-policy/">Cookie Policy</a>
      </nav>
    </div>

  </div>
</footer>


