---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const stories = await getCollection('success-stories');
  return stories.map((story) => ({
    params: { slug: story.id.replace(/\.md$/, '') },
    props: { story },
  }));
}

const { story } = Astro.props;
const { Content } = await render(story);
---

<BaseLayout
  title={`${story.data.title} | Cent Edge Success Story`}
  description={story.data.summary}
>
  <Header />

  <main id="main-content">

    <!-- HERO -->
    <section style="background: linear-gradient(135deg, #10243e 0%, #1a3f6f 100%); padding: calc(var(--header-height) + 40px) 0 50px; color: #ffffff;">
      <div class="container" style="max-width: 900px;">
        
        <nav aria-label="Breadcrumb" style="font-size: 0.85rem; margin-bottom: 20px; color: #94a3b8;">
          <a href="/" style="color: #cbd5e1; text-decoration: none;">Home</a>
          <span style="margin: 0 8px;">/</span>
          <a href="/success-stories/" style="color: #cbd5e1; text-decoration: none;">Success Stories</a>
          <span style="margin: 0 8px;">/</span>
          <span style="color: #38bdf8;">{story.data.title}</span>
        </nav>

        <div style="display: inline-block; background: #2563a8; color: #ffffff; font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 4px; margin-bottom: 16px;">
          {story.data.category}
        </div>

        <h1 style="font-family: var(--font-serif); font-size: clamp(2rem, 3.8vw, 3rem); font-weight: 700; color: #ffffff; margin-bottom: 16px; line-height: 1.2;">
          {story.data.title}
        </h1>

        <div style="font-size: 1.1rem; color: #93c5fd; font-weight: 500; margin-bottom: 24px;">
          Client: {story.data.client}
        </div>

        <!-- KPI Callout Banner -->
        <div style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.4); border-radius: 8px; padding: 14px 20px; display: inline-flex; align-items: center; gap: 12px;">
          <span style="color: #34d399; font-size: 1.2rem; font-weight: 700;">★ Documented Outcome:</span>
          <span style="color: #ffffff; font-size: 1.1rem; font-weight: 600;">{story.data.kpi}</span>
        </div>

      </div>
    </section>

    <!-- CONTENT BODY -->
    <section class="section bg-white" style="padding: 60px 0;">
      <div class="container" style="max-width: 900px;">

        <!-- Featured Image -->
        {story.data.coverImage && (
          <div style="border-radius: 12px; overflow: hidden; margin-bottom: 40px; box-shadow: 0 4px 20px rgba(0,0,0,0.08);">
            <img src={story.data.coverImage} alt={story.data.title} style="width: 100%; height: auto; max-height: 480px; object-fit: cover;" />
          </div>
        )}

        <!-- 3-Pillar Summary Cards (Challenge, Solution, Results) -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; margin-bottom: 50px;">
          {story.data.challenge && (
            <div style="background: #fff5f5; border-top: 4px solid #ef4444; border-radius: 8px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.03);">
              <h3 style="color: #991b1b; font-size: 1.05rem; font-weight: 700; margin-bottom: 8px;">The Challenge</h3>
              <p style="color: #4b5563; font-size: 0.95rem; line-height: 1.5; margin: 0;">{story.data.challenge}</p>
            </div>
          )}
          {story.data.solution && (
            <div style="background: #eff6ff; border-top: 4px solid #3b82f6; border-radius: 8px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.03);">
              <h3 style="color: #1e40af; font-size: 1.05rem; font-weight: 700; margin-bottom: 8px;">Cent Edge Solution</h3>
              <p style="color: #4b5563; font-size: 0.95rem; line-height: 1.5; margin: 0;">{story.data.solution}</p>
            </div>
          )}
          {story.data.results && (
            <div style="background: #f0fdf4; border-top: 4px solid #10b981; border-radius: 8px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.03);">
              <h3 style="color: #065f46; font-size: 1.05rem; font-weight: 700; margin-bottom: 8px;">Measurable Impact</h3>
              <p style="color: #4b5563; font-size: 0.95rem; line-height: 1.5; margin: 0;">{story.data.results}</p>
            </div>
          )}
        </div>

        <!-- Markdown Detailed Body -->
        <article class="prose-content" style="color: #334155; font-size: 1.05rem; line-height: 1.8;">
          <Content />
        </article>

        <!-- Back to Stories Link -->
        <div style="margin-top: 50px; padding-top: 24px; border-top: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
          <a href="/success-stories/" style="color: #1a3f6f; font-weight: 600; text-decoration: none;">
            &larr; Back to All Success Stories
          </a>
          <a href="/contact/" class="btn btn-primary btn-sm">Schedule a Study</a>
        </div>

      </div>
    </section>

    <!-- CONTACT CTA BAND -->
    <section class="contact-cta-band" aria-labelledby="cta-heading">
      <div class="container">
        <div class="contact-cta-box" data-reveal>
          <h2 id="cta-heading">Achieve Similar Results on Your Floor</h2>
          <p>Book a confidential diagnostic study with our senior apparel manufacturing consultants.</p>
          <div class="btn-group">
            <a href="/contact/" class="btn btn-primary" style="white-space: nowrap;">Book a Consultation</a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>