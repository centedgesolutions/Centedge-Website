---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<BaseLayout
  title="About Cent Edge | Cent Edge Apparel Consulting Bangalore"
  description="Meet Cent Edge, an execution‑led apparel manufacturing consulting firm with experience in factory setup, Lean, IE, quality and digital transformation across India, Bangladesh, Jordan and West Africa."
>
  <Header />
  <main id="main-content">
    <!-- HERO -->
    <section class="about-hero hero-white" aria-labelledby="ab-hero-heading">
      <div class="container">
        <div class="hero-white-grid" style="align-items: center;">
          
          <!-- Left Content Column -->
          <div class="hero-white-content">
            <div class="hero-eyebrow" style="margin-bottom: var(--space-4);">
              <span class="eyebrow-dot"></span>
              Apparel Manufacturing Consulting
            </div>
            
            <h1 id="ab-hero-heading" style="margin-bottom: var(--space-6); line-height: 1.1;">
              <span class="hero-leadin" style="display: block; font-family: var(--font-serif) !important; font-size: clamp(1.85rem, 2.8vw, 2.25rem); font-weight: 700; color: var(--color-navy); line-height: 1.22;">
                Built for Apparel
              </span>
              <span class="hero-accent" style="display: inline-block; font-size: clamp(2.4rem, 4.5vw, 3.5rem); margin-top: 1.75rem;">
                Manufacturing Transformation
              </span>
            </h1>
            
            <p style="color: #1a3f6f; font-weight: 700; font-size: 1.25rem; margin-bottom: 0.75rem; line-height: 1.4;">Smart Factory | Manufacturing Excellence | Profitable Results</p>
            <p class="hero-white-sub" style="font-size: var(--font-size-lg); color: var(--color-text-light); margin-bottom: var(--space-6);">
              Cent Edge Consulting Pvt Ltd is an apparel‑focused consulting and execution partner. We work across the manufacturing value chain &mdash; from feasibility, manpower and factory design to ramp‑up, productivity, quality, cost optimisation, digitisation and sustained governance.
            </p>
            
            <blockquote style="font-size: 1rem; color: #1e3a5f; font-style: italic; border-left: 3px solid #2563a8; padding: 14px 18px; margin-bottom: var(--space-6); background: #f0f5ff; border-radius: 8px;">
              Our work does not stop with recommendations. We partner with leadership and shop‑floor teams to translate the roadmap into systems, capability and measurable operating results.
            </blockquote>
            
            <div class="btn-group">
              <a href="#leadership" class="btn btn-primary">Meet Our Leadership
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
              </a>
              <a href="/contact/" class="btn btn-outline-navy">Discuss Your Requirement</a>
            </div>
          </div>

          <!-- Right Visual Column: Flat Illustration (Seamless White Background) -->
          <div class="hero-white-visual">
            <div class="hero-img-wrap" style="display: flex; align-items: center; justify-content: center;">
              <img
                src="/images/about-hero-illustration.png"
                alt="Apparel manufacturing consultancy and factory transformation illustration"
                width="700"
                height="525"
                loading="eager"
                style="width: 100%; max-width: 620px; height: auto; display: block;"
              />
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- MISSION & VISION -->
    <section class="ab-mv bg-offwhite" aria-labelledby="ab-mv-heading" data-reveal style="padding: var(--space-12) 0;">
      <div class="container">
        <div class="ab-section-header ab-section-header--center" style="margin-bottom: var(--space-8);">
          <div class="hero-eyebrow" style="justify-content: center; margin-bottom: var(--space-3);">
            <span class="eyebrow-dot"></span>
            Our Purpose
          </div>
          <h2 id="ab-mv-heading" class="ab-section-title" style="color: var(--color-navy); font-size: var(--font-size-4xl);">Mission &amp; Vision</h2>
        </div>
        <div class="ab-mv__grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--space-8);">
          <div class="ab-mv__card" style="background: var(--color-white); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-8); box-shadow: var(--shadow-sm); position: relative; overflow: hidden;">
            <div class="ab-mv__card-title" style="font-size: 1.5rem; font-weight: 700; color: var(--color-navy); margin-bottom: var(--space-4); position: relative; z-index: 1;">Mission</div>
            <p class="ab-mv__card-text" style="font-size: 1.1rem; color: var(--color-text-light); line-height: 1.7; position: relative; z-index: 1;">To partner with clients to create high levels of value and together set new standards of excellence in the apparel industry.</p>
            <div class="ab-mv__bg-word" aria-hidden="true">MISSION</div>
          </div>
          <div class="ab-mv__card" style="background: var(--color-white); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-8); box-shadow: var(--shadow-sm); position: relative; overflow: hidden;">
            <div class="ab-mv__card-title" style="font-size: 1.5rem; font-weight: 700; color: var(--color-navy); margin-bottom: var(--space-4); position: relative; z-index: 1;">Vision</div>
            <p class="ab-mv__card-text" style="font-size: 1.1rem; color: var(--color-text-light); line-height: 1.7; position: relative; z-index: 1;">To be a global partner transforming apparel factories through Lean and Industry 4.0, powered by consulting expertise and an integrated partner ecosystem.</p>
            <div class="ab-mv__bg-word" aria-hidden="true">VISION</div>
          </div>
        </div>
      </div>
    </section>

    <!-- OUR CONSULTING SOLUTIONS (Garment Industry Icons + Modern Visual Advancements) -->
      <section class="ab-caps bg-white" aria-labelledby="ab-caps-heading" data-reveal style="padding: var(--space-16) 0; position: relative; background: #ffffff;">
        <div class="container">
          
          <div class="ab-section-header ab-section-header--center" style="margin-bottom: var(--space-12); text-align: center;">
            <div class="hero-eyebrow" style="justify-content: center; margin-bottom: var(--space-3);">
              <span class="eyebrow-dot"></span>
              What We Deliver
            </div>
            <h2 id="ab-caps-heading" class="ab-section-title" style="color: var(--color-navy); font-size: clamp(2.1rem, 3.8vw, 2.75rem); font-weight: 700; margin-bottom: 0.6rem;">
              Specialist Garment Consulting Solutions
            </h2>
            <p class="ab-section-sub" style="font-size: 1.05rem; color: #64748b; max-width: 680px; margin: 0 auto; line-height: 1.6;">
              Execution-led engineering, operational excellence, and shop-floor capability building designed specifically for apparel manufacturers.
            </p>
          </div>

          <div class="garment-solutions-grid">
            
            <!-- 1. Lean Manufacturing (Sewing Line Flow) -->
            <div class="garment-sol-card">
              <div class="sol-card-accent"></div>
              <div class="sol-card-header">
                <div class="sol-icon-badge sky">
                  <!-- Sewing Machine & Continuous Flow Loop -->
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <!-- Sewing Machine Outline -->
                    <path d="M4 19h16M4 15h16M7 15V8a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v7"/>
                    <!-- Needle & Thread Line -->
                    <line x1="14" y1="9" x2="14" y2="13"/>
                    <circle cx="14" cy="14" r="0.8" fill="currentColor"/>
                    <!-- Handwheel -->
                    <line x1="19" y1="8" x2="19" y2="12"/>
                  </svg>
                </div>
                <span class="sol-tag">Lean Flow</span>
              </div>
              <h3>Lean Manufacturing</h3>
              <p>Eliminating 8 shop-floor wastes, cellular modular lines, and single-piece flow to drive 25–30% productivity gains.</p>
            </div>

            <!-- 2. 5S Implementation (Visual Factory & Red Tagging) -->
            <div class="garment-sol-card">
              <div class="sol-card-accent"></div>
              <div class="sol-card-header">
                <div class="sol-icon-badge indigo">
                  <!-- 5S Visual Board & Apparel Hanger / Tool Organization -->
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <!-- Standard Work Board -->
                    <rect x="3" y="3" width="18" height="18" rx="3"/>
                    <!-- 5S Checkpoints -->
                    <path d="M7 8h10M7 12h6M7 16h8"/>
                    <circle cx="16" cy="12" r="1.5" fill="currentColor"/>
                  </svg>
                </div>
                <span class="sol-tag">Visual Factory</span>
              </div>
              <h3>5S Implementation</h3>
              <p>Workplace organization, red-tagging campaigns, tool shadow boards, and standard work to sustain daily line discipline.</p>
            </div>

            <!-- 3. Factory Setup & Design (Plant Architecture & Machine Layout) -->
            <div class="garment-sol-card">
              <div class="sol-card-accent"></div>
              <div class="sol-card-header">
                <div class="sol-icon-badge blue">
                  <!-- Apparel Factory Facility with Sawtooth Roof & Compass Blueprint -->
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <!-- Factory Sawtooth Roof Silhouette -->
                    <path d="M2 20h20V10l-5 4V10l-5 4V7L2 13v7z"/>
                    <!-- Ventilation / Grid Window -->
                    <line x1="7" y1="16" x2="7" y2="16.01"/>
                    <line x1="12" y1="16" x2="12" y2="16.01"/>
                    <line x1="17" y1="16" x2="17" y2="16.01"/>
                  </svg>
                </div>
                <span class="sol-tag">Turnkey Setup</span>
              </div>
              <h3>Factory Setup &amp; Design</h3>
              <p>End-to-end turnkey support from civil layout and machine selection to utility piping, ventilation, and fast ramp-up.</p>
            </div>

            <!-- 4. Layout Optimisation (Material Flow & Line Balancing) -->
            <div class="garment-sol-card">
              <div class="sol-card-accent"></div>
              <div class="sol-card-header">
                <div class="sol-icon-badge emerald">
                  <!-- Plant Floor Plan with Routing Nodes from Cutting to Packing -->
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <!-- Production Cells -->
                    <rect x="3" y="3" width="6" height="6" rx="1.5"/>
                    <rect x="15" y="3" width="6" height="6" rx="1.5"/>
                    <rect x="15" y="15" width="6" height="6" rx="1.5"/>
                    <rect x="3" y="15" width="6" height="6" rx="1.5"/>
                    <!-- Material Routing Flow Arrows -->
                    <path d="M9 6h6M18 9v6M15 18H9M6 15V9"/>
                  </svg>
                </div>
                <span class="sol-tag">Capacity Boost</span>
              </div>
              <h3>Layout Optimisation</h3>
              <p>Debottlenecking material movement, WIP minimization, and progressive line flow delivering 30–50% capacity gain.</p>
            </div>

            <!-- 5. Lead Time Reduction (Cut-to-Ship & Fast Changeovers) -->
            <div class="garment-sol-card">
              <div class="sol-card-accent"></div>
              <div class="sol-card-header">
                <div class="sol-icon-badge orange">
                  <!-- Precision Stopwatch + Fast Forward Velocity -->
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="13" r="8"/>
                    <path d="M12 9v4l3 2"/>
                    <!-- Stopwatch Buttons -->
                    <path d="M12 2v3M9 3h6"/>
                    <!-- Fast Speed Dash -->
                    <path d="M19.5 7.5L21 6"/>
                  </svg>
                </div>
                <span class="sol-tag">PCD & Speed</span>
              </div>
              <h3>Lead Time Reduction</h3>
              <p>SMED quick changeovers, cut-to-ship acceleration, and raising planned cut date (PCD) hit rate from 39% to 90%+.</p>
            </div>

            <!-- 6. Quality Systems & Zero Defect (Inspection & AQL) -->
            <div class="garment-sol-card">
              <div class="sol-card-accent"></div>
              <div class="sol-card-header">
                <div class="sol-icon-badge green">
                  <!-- Quality Shield + Garment Inspection Verification -->
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    <!-- Checkmark -->
                    <path d="M8.5 12l2.5 2.5 4.5-5"/>
                  </svg>
                </div>
                <span class="sol-tag">Zero Defect</span>
              </div>
              <h3>Quality Systems</h3>
              <p>Buyer-readiness, AQL 1.5/2.5 protocols, in-line traffic light inspection, and systematic DHU/rework reduction.</p>
            </div>

            <!-- 7. IE Training & Work Study (SAM / SMV & Motion Study) -->
            <div class="garment-sol-card">
              <div class="sol-card-accent"></div>
              <div class="sol-card-header">
                <div class="sol-icon-badge amber">
                  <!-- Chronometer & GSD Method Ruler for Apparel -->
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <!-- Precision Work Study Gauge -->
                    <circle cx="12" cy="12" r="9"/>
                    <path d="M12 7v5l3 3"/>
                    <path d="M7 12h1M16 12h1M12 7V6M12 17v1"/>
                  </svg>
                </div>
                <span class="sol-tag">SAM & IE</span>
              </div>
              <h3>IE Training &amp; Work Study</h3>
              <p>Method study, SAM/SMV computation, video motion analysis, line balancing, and training floor industrial engineers.</p>
            </div>

            <!-- 8. Fabric & Cutting Excellence (Spreading, Marker, End-bit) -->
            <div class="garment-sol-card">
              <div class="sol-card-accent"></div>
              <div class="sol-card-header">
                <div class="sol-icon-badge pink">
                  <!-- Fabric Roll with Precision Tailor Shears -->
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <!-- Tailor Cutting Shears -->
                    <circle cx="6" cy="6" r="3"/>
                    <circle cx="6" cy="18" r="3"/>
                    <line x1="8.5" y1="8.5" x2="20" y2="20"/>
                    <line x1="8.5" y1="15.5" x2="20" y2="4"/>
                  </svg>
                </div>
                <span class="sol-tag">Fabric Savings</span>
              </div>
              <h3>Fabric &amp; Cutting Excellence</h3>
              <p>Marker efficiency algorithms, roll allocation, end-bit reduction, and fabric store controls saving 3–6% ($111,200/yr).</p>
            </div>

            <!-- 9. Digital & Smart Factory (Industry 4.0 & Real-Time Tracking) -->
            <div class="garment-sol-card">
              <div class="sol-card-accent"></div>
              <div class="sol-card-header">
                <div class="sol-icon-badge slate">
                  <!-- Connected Smart Sewing Unit with Wireless IoT Signals -->
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <!-- Microchip / Smart Tablet -->
                    <rect x="4" y="4" width="16" height="16" rx="2.5"/>
                    <circle cx="12" cy="12" r="2.5"/>
                    <!-- IoT Signal Pins -->
                    <path d="M12 1v3M12 20v3M1 12h3M20 12h3"/>
                  </svg>
                </div>
                <span class="sol-tag">Industry 4.0</span>
              </div>
              <h3>Digital &amp; Smart Factory</h3>
              <p>Real-time RFID/barcode garment tracking, digital line dashboards, operator tablets, and smart automated reporting.</p>
            </div>

          </div>

          </div>
      </section>

    <!-- GEOGRAPHY & PRODUCT -->
    <section class="ab-geo bg-white" aria-labelledby="ab-geo-heading" data-reveal style="padding: var(--space-12) 0;">
      <div class="container">
        <div class="ab-geo__wrapper" style="display: flex; flex-direction: column; gap: var(--space-12);">
          
          <!-- Locations Section -->
          <div class="ab-geo__locations">
            <div class="ab-section-header ab-section-header--center" style="margin-bottom: var(--space-8);">
              <div class="hero-eyebrow" style="justify-content: center; margin-bottom: var(--space-3);">
                <span class="eyebrow-dot"></span>Where We Work
              </div>
              <h2 id="ab-geo-heading" class="ab-section-title" style="color: var(--color-navy); font-size: var(--font-size-4xl);">Global Execution Experience</h2>
              <p class="ab-section-sub" style="font-size: var(--font-size-lg); color: var(--color-text-light);">Deep, first‑hand expertise from factory floors across South Asia, Southeast Asia, the Middle East and Africa.</p>
            </div>
            
            <div class="ab-geo__countries-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-6);">
              
              <div class="ab-geo__country" style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: var(--space-4); padding: var(--space-6); background: var(--color-off-white); border-radius: var(--radius-lg); border: 1px solid var(--color-border);">
                <!-- India Flag SVG -->
                <div class="ab-geo__country-flag" style="width: 60px; height: 45px; display: inline-block; overflow: hidden; border-radius: 4px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 225 150" width="100%" height="100%"><rect width="225" height="150" fill="#f93"/><rect width="225" height="50" y="50" fill="#fff"/><rect width="225" height="50" y="100" fill="#128807"/><g transform="translate(112.5,75)"><circle r="20" fill="#00084e"/><circle r="17.5" fill="#fff"/><circle r="3.5" fill="#00084e"/><g id="d"><g id="c"><g id="b"><g id="a"><path d="M0,-17.5L0.6,-7L0,-2L-0.6,-7Z" fill="#00084e"/><circle cy="-17.5" r="0.9" fill="#00084e"/></g><use href="#a" transform="rotate(15)"/></g><use href="#b" transform="rotate(30)"/></g><use href="#c" transform="rotate(60)"/></g><use href="#d" transform="rotate(120)"/><use href="#d" transform="rotate(-120)"/></g></svg>
                </div>
                <div>
                  <strong style="display: block; color: var(--color-navy); font-size: 1.2rem; margin-bottom: var(--space-2);">India</strong>
                  <span style="font-size: 0.95rem; color: var(--color-text-light);">Primary base — Bangalore, pan‑India delivery</span>
                </div>
              </div>

              <div class="ab-geo__country" style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: var(--space-4); padding: var(--space-6); background: var(--color-off-white); border-radius: var(--radius-lg); border: 1px solid var(--color-border);">
                <!-- Bangladesh Flag SVG -->
                <div class="ab-geo__country-flag" style="width: 60px; height: 45px; display: inline-block; overflow: hidden; border-radius: 4px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 10 6" width="100%" height="100%"><rect width="10" height="6" fill="#006a4e"/><circle cx="4.5" cy="3" r="2" fill="#f42a41"/></svg>
                </div>
                <div>
                  <strong style="display: block; color: var(--color-navy); font-size: 1.2rem; margin-bottom: var(--space-2);">Bangladesh</strong>
                  <span style="font-size: 0.95rem; color: var(--color-text-light);">Major garment export hub engagements</span>
                </div>
              </div>

              <div class="ab-geo__country" style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: var(--space-4); padding: var(--space-6); background: var(--color-off-white); border-radius: var(--radius-lg); border: 1px solid var(--color-border);">
                <!-- Vietnam Flag SVG -->
                <div class="ab-geo__country-flag" style="width: 60px; height: 45px; display: inline-block; overflow: hidden; border-radius: 4px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 600" width="100%" height="100%"><rect width="900" height="600" fill="#da251d"/><g transform="translate(450,300) scale(180)"><polygon points="0,-1 0.2245,-0.309 0.9511,-0.309 0.3633,0.118 0.5878,0.809 0,0.382 -0.5878,0.809 -0.3633,0.118 -0.9511,-0.309 -0.2245,-0.309" fill="#ffff00"/></g></svg>
                </div>
                <div>
                  <strong style="display: block; color: var(--color-navy); font-size: 1.2rem; margin-bottom: var(--space-2);">Vietnam</strong>
                  <span style="font-size: 0.95rem; color: var(--color-text-light);">High-volume manufacturing setups & efficiency</span>
                </div>
              </div>

              <div class="ab-geo__country" style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: var(--space-4); padding: var(--space-6); background: var(--color-off-white); border-radius: var(--radius-lg); border: 1px solid var(--color-border);">
                <!-- Jordan Flag SVG -->
                <div class="ab-geo__country-flag" style="width: 60px; height: 45px; display: inline-block; overflow: hidden; border-radius: 4px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 600" width="100%" height="100%"><rect width="1200" height="600" fill="#007a3d"/><rect width="1200" height="400" fill="#fff"/><rect width="1200" height="200" fill="#000"/><polygon points="0,0 600,300 0,600" fill="#ce1126"/><g transform="translate(200,300) scale(40)"><polygon points="0,-1 0.224,-0.309 0.951,-0.309 0.363,0.118 0.587,0.809 0,0.381 -0.587,0.809 -0.363,0.118 -0.951,-0.309 -0.224,-0.309" fill="#fff" transform="rotate(18)"/></g></svg>
                </div>
                <div>
                  <strong style="display: block; color: var(--color-navy); font-size: 1.2rem; margin-bottom: var(--space-2);">Jordan</strong>
                  <span style="font-size: 0.95rem; color: var(--color-text-light);">Factory setup and transformation projects</span>
                </div>
              </div>

              <div class="ab-geo__country" style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: var(--space-4); padding: var(--space-6); background: var(--color-off-white); border-radius: var(--radius-lg); border: 1px solid var(--color-border);">
                <!-- West Africa Flag SVG -->
                <div class="ab-geo__country-flag" style="width: 60px; height: 45px; display: inline-block; overflow: hidden; border-radius: 4px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 200" width="100%" height="100%"><rect width="300" height="200" fill="#e8112d"/><rect width="300" height="100" fill="#fcd116"/><rect width="120" height="200" fill="#008751"/></svg>
                </div>
                <div>
                  <strong style="display: block; color: var(--color-navy); font-size: 1.2rem; margin-bottom: var(--space-2);">West Africa</strong>
                  <span style="font-size: 0.95rem; color: var(--color-text-light);">Operational excellence and capacity improvement</span>
                </div>
              </div>

            </div>
          </div>
          
          <hr style="border: none; border-top: 1px solid var(--color-border); margin: var(--space-6) var(--space-8);" />
          <!-- Products Section -->
          <div class="ab-products-wrapper" style="text-align: center; padding: var(--space-8) 0 var(--space-4) 0;">
