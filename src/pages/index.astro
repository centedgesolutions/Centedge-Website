    <!-- ====================================================
         ROBUST ROADMAP (6-STAGE PROCESS)
         ==================================================== -->
    <section class="process-section section bg-white" aria-labelledby="process-heading">
      <div class="container">
        <div class="section-label" data-reveal>HOW WE CREATE IMPACT</div>
        <h2 id="process-heading" data-reveal>A Robust 6-Stage Roadmap</h2>
        <p class="section-sub" data-reveal>From baseline assessment to sustained governance and strategic partnership &mdash; structured to turn operational improvements into permanent business value.</p>
        
        <div class="process-roadmap-grid" data-reveal>
          <!-- Stage 1: ASSESS -->
          <div class="process-step">
            <div class="step-number">01</div>
            <div class="step-icon step-icon-sky">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><path d="M11 8v6M8 11h6"/></svg>
            </div>
            <h3>Assess</h3>
            <p><strong>The Current State:</strong> Develop a Current State Value Stream Map, identify and baseline all key performance indicators.</p>
          </div>

          <!-- Stage 2: DEFINE -->
          <div class="process-step">
            <div class="step-number">02</div>
            <div class="step-icon step-icon-teal">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
            </div>
            <h3>Define</h3>
            <p><strong>The Future State:</strong> Target future benchmarks for identified KPIs and prioritize Key Performance Indicators for execution.</p>
          </div>

          <!-- Stage 3: ACHIEVE -->
          <div class="process-step">
            <div class="step-number">03</div>
            <div class="step-icon step-icon-coral">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
            </div>
            <h3>Achieve</h3>
            <p><strong>Execution:</strong> On-ground implementation of improvement initiatives to achieve the set Key Performance Indicators.</p>
          </div>

          <!-- Stage 4: SUSTAIN -->
          <div class="process-step">
            <div class="step-number">04</div>
            <div class="step-icon step-icon-green">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
            </div>
            <h3>Sustain</h3>
            <p><strong>Governance:</strong> Set up a robust governance structure to sustain continuous improvement on Key Performance Indicators.</p>
          </div>

          <!-- Stage 5: ALIGN -->
          <div class="process-step">
            <div class="step-number">05</div>
            <div class="step-icon step-icon-indigo">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
            </div>
            <h3>Align</h3>
            <p><strong>Strategic Alignment:</strong> Facilitate strategic alignment to ever-changing business priorities and dynamic market demands.</p>
          </div>

          <!-- Stage 6: PARTNER -->
          <div class="process-step">
            <div class="step-number">06</div>
            <div class="step-icon step-icon-navy">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <h3>Partner</h3>
            <p><strong>Long-Term Support:</strong> Dedicated partnership as necessary until you accomplish your complete organizational mission.</p>
          </div>
        </div>

        <!-- Partnership Mission Banner -->
        <div class="roadmap-mission-banner" data-reveal style="margin-top: var(--space-10); padding: var(--space-5) var(--space-8); background: linear-gradient(135deg, rgba(37, 99, 168, 0.05) 0%, rgba(226, 109, 92, 0.08) 100%); border: 1px solid rgba(37, 99, 168, 0.16); border-radius: var(--radius-lg); display: flex; align-items: center; justify-content: center; gap: var(--space-4); text-align: center;">
          <div style="width: 38px; height: 38px; border-radius: 50%; background: var(--color-navy); color: #fff; display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: 0 4px 10px rgba(26, 46, 74, 0.2);">
