---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const allStories = await getCollection('success-stories');
const latestStories = allStories
  .sort((a, b) => {
    const dateA = new Date(a.data.publishDate || a.data.date || 0).getTime();
    const dateB = new Date(b.data.publishDate || b.data.date || 0).getTime();
    return dateB - dateA;
  })
  .slice(0, 3);

const allInsights = await getCollection('insights');
const latestInsights = allInsights
  .sort((a, b) => {
    const dateA = new Date(a.data.publishDate || a.data.date || 0).getTime();
    const dateB = new Date(b.data.publishDate || b.data.date || 0).getTime();
    return dateB - dateA;
  })
  .slice(0, 3);
---

