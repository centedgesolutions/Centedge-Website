          <!-- Breakthroughs Pure White Minimal Numbers Strip Carousel Script (Continuous Loop) -->
  <script is:inline>
  (function() {
    const wrap = document.getElementById('breakthroughsWrap');
    const track = document.getElementById('breakthroughsTrack');
    const prevBtn = document.getElementById('btPrev');
    const nextBtn = document.getElementById('btNext');
    const section = document.getElementById('breakthroughsSection');
    if (!track || !wrap) return;

    // Clone all items once to create a seamless infinite continuous conveyor
    const originalItems = Array.from(track.querySelectorAll('.bt-item'));
    const totalOriginal = originalItems.length;
    originalItems.forEach(function(item) {
      const clone = item.cloneNode(true);
      clone.setAttribute('aria-hidden', 'true');
      track.appendChild(clone);
    });

    function getHalfWidth() {
      const allItems = track.querySelectorAll('.bt-item');
      if (allItems[totalOriginal]) {
        return allItems[totalOriginal].offsetLeft - allItems[0].offsetLeft;
      }
      return track.scrollWidth / 2;
    }

    let halfWidth = getHalfWidth();
    window.addEventListener('resize', function() {
      halfWidth = getHalfWidth();
    });

    let currentX = 0;
    let targetX = 0;
    let isPaused = false;
    let inViewport = true;
    let isNudging = false;
    const glideSpeed = 0.7; // ~42px per second: calm, executive, readable flow
    const stepDistance = 190; // approx single item step for prev/next buttons

    // Pause on mouse hover over the strip or any item
    wrap.addEventListener('mouseenter', function() {
      isPaused = true;
    });

    wrap.addEventListener('mouseleave', function() {
      isPaused = false;
    });

    // Manual navigation buttons
    if (nextBtn) {
      nextBtn.addEventListener('click', function() {
        isNudging = true;
        targetX -= stepDistance;
        setTimeout(function() { isNudging = false; }, 450);
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', function() {
        isNudging = true;
        targetX += stepDistance;
        setTimeout(function() { isNudging = false; }, 450);
      });
    }

    // Touch support for mobile swipe
    let touchStartX = 0;
    let touchStartTargetX = 0;
    wrap.addEventListener('touchstart', function(e) {
      isPaused = true;
      if (e.touches && e.touches[0]) {
        touchStartX = e.touches[0].pageX;
        touchStartTargetX = targetX;
      }
    }, { passive: true });

    wrap.addEventListener('touchmove', function(e) {
      if (e.touches && e.touches[0]) {
        const dx = e.touches[0].pageX - touchStartX;
        targetX = touchStartTargetX + dx;
        currentX = targetX;
      }
    }, { passive: true });

    wrap.addEventListener('touchend', function() {
      isPaused = false;
    });

    // Viewport observer
    if ('IntersectionObserver' in window && section) {
      const observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          inViewport = entry.isIntersecting;
        });
      }, { threshold: 0.1 });
      observer.observe(section);
    }

    // Smooth 60fps animation frame loop
    function animate() {
      if (!isPaused && inViewport && !isNudging) {
        targetX -= glideSpeed;
        currentX = targetX;
      } else if (isNudging) {
        currentX += (targetX - currentX) * 0.16;
      }

      // Seamless wrap: when we have scrolled past Set 1, silently loop back by halfWidth
      if (halfWidth > 0) {
        if (currentX <= -halfWidth) {
          currentX += halfWidth;
          targetX += halfWidth;
        } else if (currentX > 0) {
          currentX -= halfWidth;
          targetX -= halfWidth;
        }
      }

      track.style.transform = 'translate3d(' + currentX.toFixed(2) + 'px, 0, 0)';
      requestAnimationFrame(animate);
    }

    // Ensure halfWidth is computed after initial render
    setTimeout(function() {
      halfWidth = getHalfWidth();
    }, 100);

    requestAnimationFrame(animate);
  })();
  </script>
