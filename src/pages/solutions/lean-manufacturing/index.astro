---
// src/pages/solutions/5s-implementation-garment-factory/index.astro
// Flagship Solution Page: 5S Workplace Transformation & Visual Factory
// Formatted with concise copy, modern typography, and rich bespoke flat illustrations across every section.

import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const pageTitle = "Lean Manufacturing & 5S Excellence for Garment Factories | Cent Edge Bangalore";
const pageDescription = "Drive lean manufacturing and 5S operational discipline in garment factories. Cent Edge eliminates waste, reclaims up to 25% floor space, cuts search times under 30 seconds, and builds visual flow.";
const canonicalUrl = "https://centedge.co.in/solutions/lean-manufacturing/";
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription}
  canonicalUrl={canonicalUrl}
>
  <Header />

  <!-- PAGE-SPECIFIC SEO SCHEMAS (Service & BreadcrumbList) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Lean Manufacturing & 5S Excellence for Garment Factories",
    "serviceType": "Lean Manufacturing and 5S Workplace Organization",
    "provider": {
      "@type": "ProfessionalService",
      "name": "Cent Edge Consulting Pvt Ltd",
      "url": "https://centedge.co.in"
    },
    "areaServed": [
      {"@type": "Country", "name": "India"},
      {"@type": "Country", "name": "Bangladesh"},
      {"@type": "Country", "name": "Jordan"},
      {"@type": "Country", "name": "Vietnam"}
    ],
    "description": "Systematic 5S implementation and visual management consulting for apparel manufacturing plants to recover floor space, reduce search waste, and sustain operational discipline.",
    "url": "https://centedge.co.in/solutions/lean-manufacturing/"
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://centedge.co.in/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Solutions",
        "item": "https://centedge.co.in/solutions/"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Lean Manufacturing",
        "item": "https://centedge.co.in/solutions/lean-manufacturing/"
      }
    ]
  }
  </script>


  <!-- BREADCRUMB NAVIGATION -->
  <nav class="breadcrumb-bar" aria-label="Breadcrumb">
    <div class="container">
      <ol class="breadcrumb-list">
        <li><a href="/">Home</a></li>
        <li class="breadcrumb-separator">/</li>
        <li><a href="/solutions/">Solutions</a></li>
        <li class="breadcrumb-separator">/</li>
        <li class="breadcrumb-current" aria-current="page">Lean Manufacturing</li>
      </ol>
    </div>
  </nav>

  <main class="page-wrapper">
    <!-- ============================================================ -->
    <!-- 1. HERO SECTION WITH FLAT ILLUSTRATION & METRIC CHIPS -->
    <!-- ============================================================ -->
    <section class="hero-section">
      <div class="container hero-container">
        <div class="hero-content">
          <div class="hero-badge">
            <span class="badge-dot"></span>
            <span>Lean Manufacturing &bull; 5S Operational Discipline</span>
          </div>
          <h1 class="hero-title">
            Transform Chaotic Apparel Floors into <em>High Performing Visual Workplaces</em>
          </h1>
          <p class="hero-desc">
            Cent Edge’s structured 5S methodology eliminates shop-floor clutter, recovers up to <strong>25% floor space</strong>,  creates 'search free' work environment, improved machine uptime and builds lasting operational discipline.
          </p>
          <div class="hero-actions">
            <a href="/contact/" class="btn-primary">
              <span>Book a 5S Dipstick Study</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
            <a href="https://wa.me/919901422066?text=Hi%20Cent%20Edge%20team,%20we%20want%20to%20explore%205S%20implementation%20for%20our%20garment%20factory" target="_blank" rel="noopener noreferrer" class="btn-secondary">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#25D366" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
              </svg>
              <span>Chat with 5S Expert</span>
            </a>
          </div>

          <div class="hero-trust-row">
            <div class="trust-badge-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Page Industries (Jockey) - Platinum and model level</span>
            </div>
            <div class="trust-badge-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Arvind Limited - Platinum and Sustenance level</span>
            </div>
          </div>
        </div>

        <div class="hero-visual">
          <div class="hero-image-wrapper">
            <img 
              src="/images/5s-hero-illustration.jpg" 
              alt="5S Visual Apparel Factory Transformation Illustration" 
              class="hero-illustration"
              loading="eager"
            />
          </div>
        </div>
      </div>

      <!-- KEY RESULTS & BENCHMARKS STRIP -->
      <div class="results-ticker-strip">
        <div class="container">
          <!-- Live Eyebrow Header -->
          <div class="ticker-header-bar">
            <div class="ticker-badge-live">
              <span class="live-dot-ping"></span>
              <span class="live-badge-text">5S OPERATIONAL BREAKTHROUGHS</span>
            </div>
            <div class="ticker-header-trust">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              <span>Validated Across Multi-Unit Apparel Plants</span>
            </div>
          </div>

          <!-- 4 Advanced Metric Cards -->
          <div class="ticker-inner">
            <!-- Card 1 -->
            <div class="ticker-card">
              <div class="card-accent-gradient"></div>
              <div class="ticker-card-header">
                <span class="ticker-pill pill-blue">Space Reclaimed</span>
                <div class="ticker-icon-wrap wrap-blue">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="3" y1="9" x2="21" y2="9"></line>
                    <line x1="9" y1="21" x2="9" y2="9"></line>
                  </svg>
                </div>
              </div>
              <div class="ticker-stat-block">
                <div class="ticker-num">
                  <span class="num-val">15<span class="num-dash">&ndash;</span>25</span><span class="num-suffix">%</span>
                </div>
              </div>
              <h4 class="ticker-title">Floor Space Unlocked</h4>
              <p class="ticker-desc">Eliminate obsolete racks, dead stock, and line clutter without building new sheds.</p>
              <div class="ticker-card-footer">
                <span class="footer-chip">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>Zero CAPEX Expansion</span>
                </span>
              </div>
            </div>

            <!-- Card 2 -->
            <div class="ticker-card">
              <div class="card-accent-gradient"></div>
              <div class="ticker-card-header">
                <span class="ticker-pill pill-amber">Search Waste</span>
                <div class="ticker-icon-wrap wrap-amber">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="13" r="8"></circle>
                    <path d="M12 9v4l2 2"></path>
                    <path d="M5 3L2 6"></path>
                    <path d="M22 6l-3-3"></path>
                    <path d="M12 2v3"></path>
                  </svg>
                </div>
              </div>
              <div class="ticker-stat-block">
                <div class="ticker-num">
                  <span class="num-prefix">&lt;</span><span class="num-val">30</span><span class="num-suffix">s</span>
                </div>
              </div>
              <h4 class="ticker-title">Tool &amp; Trim Access Time</h4>
              <p class="ticker-desc">Color-coded visual staging ensures operators find trims, folders, and guides in seconds.</p>
              <div class="ticker-card-footer">
                <span class="footer-chip">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>Instant Line Feeding</span>
                </span>
              </div>
            </div>

            <!-- Card 3 -->
            <div class="ticker-card">
              <div class="card-accent-gradient"></div>
              <div class="ticker-card-header">
                <span class="ticker-pill pill-emerald">Uptime</span>
                <div class="ticker-icon-wrap wrap-emerald">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    <polyline points="9 12 11 14 15 10"></polyline>
                  </svg>
                </div>
              </div>
              <div class="ticker-stat-block">
                <div class="ticker-num">
                  <span class="num-val">40</span><span class="num-suffix">%</span>
                </div>
              </div>
              <h4 class="ticker-title">Fewer Lint Breakdowns</h4>
              <p class="ticker-desc">Autonomous cleaning and inspection routines stop lint choke and broken needle stops.</p>
              <div class="ticker-card-footer">
                <span class="footer-chip">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>Preventive Reliability</span>
                </span>
              </div>
            </div>

            <!-- Card 4 -->
            <div class="ticker-card">
              <div class="card-accent-gradient"></div>
              <div class="ticker-card-header">
                <span class="ticker-pill pill-purple">Compliance</span>
                <div class="ticker-icon-wrap wrap-purple">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="8" r="6"></circle>
                    <path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"></path>
                  </svg>
                </div>
              </div>
              <div class="ticker-stat-block">
                <div class="ticker-num">
                  <span class="num-val">98</span><span class="num-suffix">%+</span>
                </div>
              </div>
              <h4 class="ticker-title">Audit Sustenance Score</h4>
              <p class="ticker-desc">Structured 5S red tag audits and visual scorecards prevent backsliding into chaos.</p>
              <div class="ticker-card-footer">
                <span class="footer-chip">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>Continuous Discipline</span>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 2. SECTION 2: SHOP-FLOOR CHALLENGES (WITH 4 FLAT ILLUSTRATIONS) -->
    <!-- ============================================================ -->
    <section class="section section-challenges">
      <div class="container">
        <div class="section-header text-center">
          <span class="section-tag section-tag-danger">Shop-Floor Bottlenecks</span>
          <h2 class="section-title">Where Unorganized Apparel Floors Bleed Margins</h2>
          <p class="section-subtitle">
            Small shop-floor inefficiencies compound across hundreds of sewing machines into massive lost hours, fabric rejection, and buyer audit failures.
          </p>
        </div>

        <div class="challenges-grid">
          <!-- Card 1 -->
          <div class="challenge-card">
            <div class="challenge-img-box">
              <img 
                src="/images/5s-challenge-clutter.jpg" 
                alt="Cluttered Aisles and Fabric Scraps Illustration" 
                class="challenge-illustration"
                loading="lazy"
              />
              <span class="challenge-num">01</span>
            </div>
            <div class="challenge-body">
              <span class="challenge-pill pill-danger">Space &amp; Safety Hazard</span>
              <h3 class="challenge-heading">Cluttered Aisles &amp; Fabric Scrap</h3>
              <p class="challenge-text">
                Fabric scraps, trims, and pallets spill into gangways, restricting bundle movement, causing tripping risks, and creating a chaotic audit impression.
              </p>
              <div class="challenge-impact">
                <strong>Impact:</strong> 15–20% floor space congested by unneeded items.
              </div>
            </div>
          </div>

          <!-- Card 2 -->
          <div class="challenge-card">
            <div class="challenge-img-box">
              <img 
                src="/images/5s-challenge-search.jpg" 
                alt="Search Time Waste Illustration" 
                class="challenge-illustration"
                loading="lazy"
              />
              <span class="challenge-num">02</span>
            </div>
            <div class="challenge-body">
              <span class="challenge-pill pill-amber">Labor Time Loss</span>
              <h3 class="challenge-heading">15–20 Min Search Waste Daily</h3>
              <p class="challenge-text">
                Operators and mechanics wander the shop floor looking for scissors, gauges, thread spools, size stickers, and work orders.
              </p>
              <div class="challenge-impact">
                <strong>Impact:</strong> Over 120 productive hours lost per sewing line monthly.
              </div>
            </div>
          </div>

          <!-- Card 3 -->
          <div class="challenge-card">
            <div class="challenge-img-box">
              <img 
                src="/images/5s-challenge-breakdown.jpg" 
                alt="Sewing Machine Breakdown and Lint Dust Illustration" 
                class="challenge-illustration"
                loading="lazy"
              />
              <span class="challenge-num">03</span>
            </div>
            <div class="challenge-body">
              <span class="challenge-pill pill-warning">Equipment Downtime</span>
              <h3 class="challenge-heading">Lint Build-up &amp; Breakdowns</h3>
              <p class="challenge-text">
                Without regular cleaning routines, fabric lint chokes machine mechanisms, causing oil staining on garments, skipped stitches, and line halts.
              </p>
              <div class="challenge-impact">
                <strong>Impact:</strong> Unplanned machine downtime and high needle breakage.
              </div>
            </div>
          </div>

          <!-- Card 4 -->
          <div class="challenge-card">
            <div class="challenge-img-box">
              <img 
                src="/images/5s-challenge-relapse.jpg" 
                alt="Culture Relapse After 30 Days Illustration" 
                class="challenge-illustration"
                loading="lazy"
              />
              <span class="challenge-num">04</span>
            </div>
            <div class="challenge-body">
              <span class="challenge-pill pill-danger">Sustenance Decay</span>
              <h3 class="challenge-heading">Relapsing Within 30 Days</h3>
              <p class="challenge-text">
                Most 5S efforts are treated as one-off housekeeping drives. Without daily visual controls and Gemba rhythms, old messy habits quickly return.
              </p>
              <div class="challenge-impact">
                <strong>Impact:</strong> Waste of management time with zero cultural shift.
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 3. SECTION 3: THE 5 PILLARS (WITH 5 DEDICATED FLAT SPOT ILLUSTRATIONS) -->
    <!-- ============================================================ -->
    <section class="section section-pillars">
      <div class="container">
        <div class="section-header text-center">
          <span class="section-tag">Cent Edge 5S Framework</span>
          <h2 class="section-title">The 5 Disciplines Built for Garment Manufacturing</h2>
          <p class="section-subtitle">
            Every step is customized for the high-velocity demands of apparel cutting, sewing, finishing, and warehouse operations.
          </p>
        </div>

        <div class="pillars-showcase">
          <!-- Pillar 1: Sort -->
          <div class="pillar-row">
            <div class="pillar-visual">
              <div class="spot-frame">
                <img 
                  src="/images/5s-sort-spot.jpg" 
                  alt="1S Sort Seiri Apparel Floor Red Tagging Illustration" 
                  class="spot-illustration"
                  loading="lazy"
                />
                <div class="spot-tag">1S &bull; Seiri</div>
              </div>
            </div>
            <div class="pillar-content">
              <div class="pillar-badge">Step 01 &bull; Sort</div>
              <h3 class="pillar-title">Eliminate Clutter &amp; Reclaim Valuable Square Footage</h3>
              <p class="pillar-lead">
                Differentiating between what is needed right now and what belongs in storage or scrap.
              </p>
              <ul class="pillar-checklist">
                <li>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563a8" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span><strong>Red Tag Strategy:</strong> Fast tagging of obsolete fabric bundles, dead trims, and broken machine parts.</span>
                </li>
                <li>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563a8" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span><strong>Holding Area Protocols:</strong> Structured 48-hour quarantine zone for disposition and asset recovery.</span>
                </li>
                <li>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563a8" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span><strong>Immediate Space Recovery:</strong> Unlocks 15–25% floor space for additional lines or buffer staging.</span>
                </li>
              </ul>
              <div class="pillar-metric-chip">
                <span class="metric-highlight">Result:</span> 15–25% floor space unlocked at zero capital expense
              </div>
            </div>
          </div>

          <!-- Pillar 2: Set In Order -->
          <div class="pillar-row pillar-row-reverse">
            <div class="pillar-visual">
              <div class="spot-frame">
                <img 
                  src="/images/5s-setinorder-spot.jpg" 
                  alt="2S Set in Order Seiton Workstation Shadow Board Illustration" 
                  class="spot-illustration"
                  loading="lazy"
                />
                <div class="spot-tag">2S &bull; Seiton</div>
              </div>
            </div>
            <div class="pillar-content">
              <div class="pillar-badge">Step 02 &bull; Set in Order</div>
              <h3 class="pillar-title">A Place for Everything, and Everything in Its Place</h3>
              <p class="pillar-lead">
                Standardized visual locations so any tool, trim, or work order is accessible in seconds.
              </p>
              <ul class="pillar-checklist">
                <li>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563a8" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span><strong>Workstation Shadow Boards:</strong> Exact silhouettes for snips, tweezers, folders, and allen keys.</span>
                </li>
                <li>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563a8" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span><strong>Aisle &amp; Zone Demarcations:</strong> Clear color-coded floor striping for WIP, finished bins, and gangways.</span>
                </li>
                <li>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563a8" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span><strong>30-Second Retrieval Rule:</strong> Zero operator walking waste during production runs.</span>
                </li>
              </ul>
              <div class="pillar-metric-chip">
                <span class="metric-highlight">Result:</span> Tool &amp; trim search time slashed by 85%
              </div>
            </div>
          </div>

          <!-- Pillar 3: Shine -->
          <div class="pillar-row">
            <div class="pillar-visual">
              <div class="spot-frame">
                <img 
                  src="/images/5s-shine-spot.jpg" 
                  alt="3S Shine Seiso Sewing Machine Cleaning Inspection Illustration" 
                  class="spot-illustration"
                  loading="lazy"
                />
                <div class="spot-tag">3S &bull; Seiso</div>
              </div>
            </div>
            <div class="pillar-content">
              <div class="pillar-badge">Step 03 &bull; Shine</div>
              <h3 class="pillar-title">Cleaning is Inspection: Catch Breakdowns Early</h3>
              <p class="pillar-lead">
                Transform daily cleaning into proactive preventive maintenance for high-speed sewing machines.
              </p>
              <ul class="pillar-checklist">
                <li>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563a8" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span><strong>5-Minute Daily Clean Routine:</strong> End-of-shift lint brushing, oil level checks, and needle inspection.</span>
                </li>
                <li>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563a8" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span><strong>Fugai Tagging System:</strong> Immediate visual tagging of oil leaks, loose bolts, and vibration.</span>
                </li>
                <li>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563a8" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span><strong>Defect Prevention:</strong> Eliminates oil-spotted garments and costly fabric rework.</span>
                </li>
              </ul>
              <div class="pillar-metric-chip">
                <span class="metric-highlight">Result:</span> 40% reduction in unplanned sewing line stoppages
              </div>
            </div>
          </div>

          <!-- Pillar 4: Standardize -->
          <div class="pillar-row pillar-row-reverse">
            <div class="pillar-visual">
              <div class="spot-frame">
                <img 
                  src="/images/5s-pillar-standardize.jpg" 
                  alt="4S Standardize Seiketsu Visual SOPs Illustration" 
                  class="spot-illustration"
                  loading="lazy"
                />
                <div class="spot-tag">4S &bull; Seiketsu</div>
              </div>
            </div>
            <div class="pillar-content">
              <div class="pillar-badge">Step 04 &bull; Standardize</div>
              <h3 class="pillar-title">Visual SOPs &amp; One-Point Lessons at Point of Work</h3>
              <p class="pillar-lead">
                Embedding visual standards so deviations are instantly obvious to anyone walking the floor.
              </p>
              <ul class="pillar-checklist">
                <li>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563a8" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span><strong>Pictorial Bilingual SOPs:</strong> Photo-based guides for station setup, bobbin changes, and quality checks.</span>
                </li>
                <li>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563a8" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span><strong>One-Point Lessons (OPLs):</strong> 1-page visual standard cards created and maintained by floor supervisors.</span>
                </li>
                <li>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563a8" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span><strong>Unified Visual Cues:</strong> Standard color tapes for scrap, fabric rolls, quarantine, and inspection.</span>
                </li>
              </ul>
              <div class="pillar-metric-chip">
