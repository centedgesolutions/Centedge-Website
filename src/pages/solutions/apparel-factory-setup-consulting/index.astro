---
// src/pages/solutions/apparel-factory-setup-consulting/index.astro
// Flagship Solution Page: Turnkey Apparel Factory Setup Consulting
// Built with bespoke modern flat vector illustrations, scannable consulting copy, and strict Cent Edge branding.

import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const pageTitle = "Turnkey Apparel Factory Setup Consultants | Cent Edge Bangalore";
const pageDescription = "Plan and launch garment factories with turnkey feasibility, manpower availability surveys, plant layout, CAPEX modelling, machine specs, quality systems, and production ramp-up.";
const canonicalUrl = "https://centedge.co.in/solutions/apparel-factory-setup-consulting/";
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription}
  canonicalUrl={canonicalUrl}
>
  <Header />

  <!-- PAGE-SPECIFIC SEO SCHEMAS (Service & BreadcrumbList) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Turnkey Apparel Factory Setup Consulting",
    "serviceType": "Greenfield and Brownfield Garment Factory Setup Consulting",
    "provider": {
      "@type": "ProfessionalService",
      "name": "Cent Edge Consulting Pvt Ltd",
      "url": "https://centedge.co.in"
    },
    "areaServed": [
      {"@type": "Country", "name": "India"},
      {"@type": "Country", "name": "Bangladesh"},
      {"@type": "Country", "name": "Jordan"},
      {"@type": "Country", "name": "Vietnam"}
    ],
    "description": "Turnkey garment factory setup consulting: feasibility studies, civil and MEP coordination, plant layout optimization, machinery procurement advisory, and commercial production ramp-up.",
    "url": "https://centedge.co.in/solutions/apparel-factory-setup-consulting/"
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://centedge.co.in/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Solutions",
        "item": "https://centedge.co.in/solutions/"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Apparel Factory Setup",
        "item": "https://centedge.co.in/solutions/apparel-factory-setup-consulting/"
      }
    ]
  }
  </script>


  <!-- BREADCRUMB NAVIGATION -->
  <nav class="breadcrumb-bar" aria-label="Breadcrumb">
    <div class="container">
      <ol class="breadcrumb-list">
        <li><a href="/">Home</a></li>
        <li class="breadcrumb-separator">/</li>
        <li><a href="/solutions/">Solutions</a></li>
        <li class="breadcrumb-separator">/</li>
        <li class="breadcrumb-current" aria-current="page">Apparel Factory Setup Consulting</li>
      </ol>
    </div>
  </nav>

  <main class="page-wrapper">
    <!-- ============================================================ -->
    <!-- 1. HERO SECTION WITH FLAT ILLUSTRATION & METRIC CHIPS -->
    <!-- ============================================================ -->
    <section class="hero-section">
      <div class="container hero-container">
        <div class="hero-content">
          <div class="hero-badge">
            <span class="badge-dot"></span>
            <span>Turnkey Apparel Advisory &bull; Greenfield &amp; Expansion</span>
          </div>
          <h1 class="hero-title">
            Plan, Build &amp; Launch <em>World-Class</em> Garment Factories with Zero Guesswork
          </h1>
          <p class="hero-desc">
            End-to-end turnkey advisory from location feasibility and labor catchment surveys to lean plant layout, CAPEX optimization, machinery selection, and rapid commercial ramp-up.
          </p>
          <div class="hero-actions">
            <a href="/contact/" class="btn-primary">
              <span>Schedule a Setup Consultation</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
            <a href="https://wa.me/919901422066?text=Hi%20Cent%20Edge%20team,%20we%20want%20to%20discuss%20setting%20up%20a%20new%20garment%20factory" target="_blank" rel="noopener noreferrer" class="btn-secondary">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#25D366" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
              </svg>
              <span>Chat with Setup Specialist</span>
            </a>
          </div>

                    <div class="hero-trust-row">
            <div class="trust-badge-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>100+ Turnkey Factory Setups &amp; Relocations</span>
            </div>
          </div>
        </div>

        <div class="hero-visual">
          <div class="hero-image-wrapper">
            <img 
              src="/images/factory-setup-hero-illustration.jpg" 
              alt="Turnkey Apparel Factory Setup Planning" 
              class="hero-illustration"
              loading="eager"
            />
          </div>
        </div>
      </div>

      <!-- KEY RESULTS & BENCHMARKS STRIP -->
      <div class="results-ticker-strip">
        <div class="container">
          <!-- Live Eyebrow Header -->
          <div class="ticker-header-bar">
            <div class="ticker-badge-live">
              <span class="live-dot-ping"></span>
              <span class="live-badge-text">TURNKEY SETUP BENCHMARKS</span>
            </div>
            <div class="ticker-header-trust">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              <span>Validated Across Greenfield Plants &amp; Relocations</span>
            </div>
          </div>

          <!-- 4 Advanced Metric Cards -->
          <div class="ticker-inner">
            <!-- Card 1 -->
            <div class="ticker-card">
              <div class="card-accent-gradient"></div>
              <div class="ticker-card-header">
                <span class="ticker-pill pill-blue">CAPEX Savings</span>
                <div class="ticker-icon-wrap wrap-blue">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                  </svg>
                </div>
              </div>
              <div class="ticker-stat-block">
                <div class="ticker-num">
                  <span class="num-val">15<span class="num-dash">&ndash;</span>20</span><span class="num-suffix">%</span>
                </div>
              </div>
              <h4 class="ticker-title">CAPEX Budget Saved</h4>
              <p class="ticker-desc">Brand-neutral machinery selection and right-sized utility layout stop vendor-driven overspend.</p>
              <div class="ticker-card-footer">
                <span class="footer-chip">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>Optimized Investment</span>
                </span>
              </div>
            </div>

            <!-- Card 2 -->
            <div class="ticker-card">
              <div class="card-accent-gradient"></div>
              <div class="ticker-card-header">
                <span class="ticker-pill pill-emerald">Speed to Market</span>
                <div class="ticker-icon-wrap wrap-emerald">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                  </svg>
                </div>
              </div>
              <div class="ticker-stat-block">
                <div class="ticker-num">
                  <span class="num-val">90</span><span class="num-suffix">Days</span>
                </div>
              </div>
              <h4 class="ticker-title">Commercial Ramp-Up</h4>
              <p class="ticker-desc">Structured pilot runs and multi-skilling take new lines to target efficiency within 3 months.</p>
              <div class="ticker-card-footer">
                <span class="footer-chip">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>Faster Break-Even</span>
                </span>
              </div>
            </div>

            <!-- Card 3 -->
            <div class="ticker-card">
              <div class="card-accent-gradient"></div>
              <div class="ticker-card-header">
                <span class="ticker-pill pill-purple">Labor Catchment</span>
                <div class="ticker-icon-wrap wrap-purple">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                </div>
              </div>
              <div class="ticker-stat-block">
                <div class="ticker-num">
                  <span class="num-val">100</span><span class="num-suffix">%</span>
                </div>
              </div>
              <h4 class="ticker-title">Location Feasibility</h4>
              <p class="ticker-desc">Door-to-door village manpower surveys guarantee sewing talent availability before land acquisition.</p>
              <div class="ticker-card-footer">
                <span class="footer-chip">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>Zero Site Regret</span>
                </span>
              </div>
            </div>

            <!-- Card 4 -->
            <div class="ticker-card">
              <div class="card-accent-gradient"></div>
              <div class="ticker-card-header">
                <span class="ticker-pill pill-amber">Investor Satisfaction</span>
                <div class="ticker-icon-wrap wrap-amber">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="8" r="6"></circle>
                    <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"></path>
                  </svg>
                </div>
              </div>
              <div class="ticker-stat-block">
                <div class="ticker-num">
                  <span class="num-val">100</span><span class="num-suffix">%</span>
                </div>
              </div>
              <h4 class="ticker-title">Promoter &amp; Board Approval</h4>
              <p class="ticker-desc">Full stakeholder alignment with zero post-handover friction, backed by self-sufficient factory teams and permanent standard operating documentation.</p>
              <div class="ticker-card-footer">
                <span class="footer-chip">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>Total Investor Peace of Mind</span>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 2. SECTION 2: CRITICAL RISKS (4 FLAT VECTOR ILLUSTRATIONS) -->
    <!-- ============================================================ -->
    <section class="section section-risks">
      <div class="container">
        <div class="section-header text-center">
          <span class="section-tag section-tag-danger">Investment Risks</span>
          <h2 class="section-title">Critical Decisions to Get Right Before Committing Capital</h2>
          <p class="section-subtitle">
            60% of new garment factories struggle with losses in Year 1 due to avoidable setup flaws. Cent Edge eliminates these risks before breaking ground.
          </p>
        </div>

                <div class="challenges-grid">
          <!-- Card 1 -->
          <div class="challenge-card">
            <span class="card-faded-number" aria-hidden="true">01</span>
            <div class="card-content">
              <div class="card-icon"><i class="ti ti-map-pin-off"></i></div>
              <div class="card-accent-bar"></div>
              <span class="challenge-pill pill-location">Location Risk</span>
              <h3 class="challenge-heading">Flawed Site Selection &amp; Labor Deficit</h3>
              <p class="challenge-text">
                Selecting sites based purely on cheap land without validating female sewing labor availability, transport accessibility, and wage levels leads to chronic machine under-utilization.
              </p>
              <div class="challenge-impact">
                <strong>Impact:</strong> 40&ndash;50% vacant machine lines within months of launch.
              </div>
            </div>
          </div>

          <!-- Card 2 -->
          <div class="challenge-card">
            <span class="card-faded-number" aria-hidden="true">02</span>
            <div class="card-content">
              <div class="card-icon"><i class="ti ti-package-off"></i></div>
              <div class="card-accent-bar"></div>
              <span class="challenge-pill pill-capex">CAPEX Bloat</span>
              <h3 class="challenge-heading">Machinery Over-Specification &amp; Vendor Bias</h3>
              <p class="challenge-text">
                Procuring expensive computerized machines without style-specific justification, guided by vendor sales quotas rather than neutral industrial engineering needs, inflates payback periods.
              </p>
              <div class="challenge-impact">
                <strong>Impact:</strong> Massive capital lock-in with 4+ year ROI delay.
              </div>
            </div>
          </div>

          <!-- Card 3 -->
          <div class="challenge-card">
            <span class="card-faded-number" aria-hidden="true">03</span>
            <div class="card-content">
              <div class="card-icon"><i class="ti ti-layout-off"></i></div>
              <div class="card-accent-bar"></div>
              <span class="challenge-pill pill-structural">Structural Bottleneck</span>
              <h3 class="challenge-heading">Civil Layout Without Flow Engineering</h3>
              <p class="challenge-text">
                Constructing column spans, gangways, and utility drops without input from apparel industrial engineers bakes permanent material handling waste, cramped aisles, and safety violations into the civil structure.
              </p>
              <div class="challenge-impact">
                <strong>Impact:</strong> Permanent 20&ndash;25% throughput loss in material transit.
              </div>
            </div>
          </div>

          <!-- Card 4 -->
          <div class="challenge-card">
            <span class="card-faded-number" aria-hidden="true">04</span>
            <div class="card-content">
              <div class="card-icon"><i class="ti ti-clock-off"></i></div>
              <div class="card-accent-bar"></div>
              <span class="challenge-pill pill-execution">Execution Delay</span>
              <h3 class="challenge-heading">Delayed Commercial Ramp-Up &amp; Cash Drain</h3>
              <p class="challenge-text">
                Starting commercial production without balanced lines, validated stitch times, or structured quality gating causes high defect rates, failed buyer audits, and severe working capital burn.
              </p>
              <div class="challenge-impact">
                <strong>Impact:</strong> Delayed break-even and buyer penalty risks.
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 3. SECTION 3: THE 6 TURNKEY SETUP SCOPE PILLARS -->
    <!-- ============================================================ -->
    <section class="section section-scope">
      <div class="container">
        <div class="section-header text-center">
          <span class="section-tag">Cent Edge Turnkey Advisory</span>
          <h2 class="section-title">The 6 Pillars of Apparel Factory Setup</h2>
          <p class="section-subtitle">
            A comprehensive turnkey advisory framework from initial feasibility studies through commercial production handover.
          </p>
        </div>

                <div class="modules-grid">
          <!-- Pillar 1 -->
          <div class="module-card">
            <span class="card-faded-number" aria-hidden="true">01</span>
            <div class="card-content">
              <div class="card-icon"><i class="ti ti-map-pin"></i></div>
              <div class="card-accent-bar"></div>
              <div class="module-badge">Pillar 01</div>
              <h3 class="module-title">Location Analysis &amp; Manpower Survey</h3>
              <p class="module-desc">
                Evaluate regional manufacturing hubs, local wage structures, female labor availability, and transportation corridors to secure a sustainable workforce.
              </p>
              <ul class="module-list">
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563a8" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg><span>10&ndash;15 km catchment demographic survey of sewing workforce</span></li>
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563a8" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Prevailing wage benchmarks, absenteeism &amp; turnover risk audit</span></li>
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563a8" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg><span>State textile policy subsidies, capital incentives &amp; utility review</span></li>
              </ul>
              <div class="module-result-chip">
                <strong>Result:</strong> 100% verified labor pipeline and location suitability.
              </div>
            </div>
          </div>

          <!-- Pillar 2 -->
          <div class="module-card">
            <span class="card-faded-number" aria-hidden="true">02</span>
            <div class="card-content">
              <div class="card-icon"><i class="ti ti-chart-line"></i></div>
              <div class="card-accent-bar"></div>
              <div class="module-badge">Pillar 02</div>
              <h3 class="module-title">Project Feasibility &amp; Financial Modelling</h3>
              <p class="module-desc">
                Build a rigorous, bankable financial blueprint detailing total CAPEX, operating cash flows, working capital requirements, and projected break-even timelines.
              </p>
              <ul class="module-list">
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563a8" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Itemized CAPEX breakdown: civil, machinery, utilities &amp; tooling</span></li>
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563a8" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg><span>5-year P&amp;L projection, cash flow sensitivity &amp; break-even analysis</span></li>
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563a8" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Detailed Project Report (DPR) tailored for banks &amp; institutional investors</span></li>
              </ul>
              <div class="module-result-chip">
                <strong>Result:</strong> Bank-ready detailed project model with verified capital payback.
              </div>
            </div>
          </div>

          <!-- Pillar 3 -->
          <div class="module-card">
            <span class="card-faded-number" aria-hidden="true">03</span>
            <div class="card-content">
              <div class="card-icon"><i class="ti ti-tools"></i></div>
              <div class="card-accent-bar"></div>
              <div class="module-badge">Pillar 03</div>
              <h3 class="module-title">Machinery Selection &amp; Utility Engineering</h3>
              <p class="module-desc">
                Vendor-independent machinery specification tailored strictly to target product styling, balancing automation with capital efficiency.
              </p>
              <ul class="module-list">
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563a8" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Operation-wise machinery breakdown based on target garment SMVs</span></li>
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563a8" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Neutral brand comparison, vendor price negotiations &amp; contract review</span></li>
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563a8" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Utility sizing: steam piping, compressed air loop &amp; transformer loads</span></li>
              </ul>
              <div class="module-result-chip">
                <strong>Result:</strong> Zero vendor bias and 15&ndash;20% saved on machine procurements.
              </div>
            </div>
          </div>

          <!-- Pillar 4 -->
          <div class="module-card">
            <span class="card-faded-number" aria-hidden="true">04</span>
            <div class="card-content">
              <div class="card-icon"><i class="ti ti-layout-board"></i></div>
              <div class="card-accent-bar"></div>
              <div class="module-badge">Pillar 04</div>
              <h3 class="module-title">Lean Factory Layout &amp; Flow Engineering</h3>
              <p class="module-desc">
                Architectural and industrial engineering layouts designed for unidirectional flow from raw fabric intake to final container dispatch.
              </p>
              <ul class="module-list">
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563a8" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Unidirectional material flow preventing backtracking &amp; cross-traffic</span></li>
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563a8" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Modular sewing lines, progressive bundle systems &amp; buffer staging</span></li>
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563a8" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Compliance-ready emergency egress, boiler isolation &amp; dining facilities</span></li>
              </ul>
              <div class="module-result-chip">
                <strong>Result:</strong> Zero backtracking and 20&ndash;25% higher floor space productivity.
              </div>
            </div>
          </div>

          <!-- Pillar 5 -->
          <div class="module-card">
            <span class="card-faded-number" aria-hidden="true">05</span>
            <div class="card-content">
              <div class="card-icon"><i class="ti ti-rosette"></i></div>
              <div class="card-accent-bar"></div>
              <div class="module-badge">Pillar 05</div>
              <h3 class="module-title">Quality Systems &amp; Compliance Readiness</h3>
              <p class="module-desc">
                Establish rigorous quality control gates and social compliance protocols so your plant passes global buyer audits from day one.
              </p>
              <ul class="module-list">
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563a8" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg><span>4-point fabric inspection, pilot cut audits &amp; end-line AQL standards</span></li>
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563a8" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg><span>SOP manuals for cutting, sewing, finishing, QA &amp; machine maintenance</span></li>
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563a8" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Pre-audit alignment for SEDEX, WRAP, BSCI, Higg Index &amp; ISO 9001</span></li>
              </ul>
              <div class="module-result-chip">
                <strong>Result:</strong> Global brand approval on first audit cycle with zero rework.
              </div>
            </div>
          </div>

          <!-- Pillar 6 -->
          <div class="module-card">
            <span class="card-faded-number" aria-hidden="true">06</span>
            <div class="card-content">
              <div class="card-icon"><i class="ti ti-trending-up"></i></div>
              <div class="card-accent-bar"></div>
              <div class="module-badge">Pillar 06</div>
              <h3 class="module-title">Pilot Runs &amp; Rapid Production Ramp-Up</h3>
              <p class="module-desc">
                Hands-on shop-floor setting to take your lines from initial trial garments to commercial export shipments in record time.
              </p>
              <ul class="module-list">
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563a8" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Operator skill grading, motor training &amp; quick-changeover drills</span></li>
