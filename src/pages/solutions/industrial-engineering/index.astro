---
// src/pages/solutions/industrial-engineering/index.astro
// Flagship Solution Page: Industrial Engineering Excellence for Garment Factories
// Built with bespoke modern flat illustrations, scannable consulting copy, and strict Cent Edge branding.

import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const pageTitle = "Industrial Engineering Consulting for Garment Factories | Cent Edge Bangalore";
const pageDescription = "Convert Industrial Engineering into measurable apparel productivity and throughput. Cent Edge connects SMV standards, capacity planning, line balancing, and motion engineering to business performance.";
const canonicalUrl = "https://centedge.co.in/solutions/industrial-engineering/";
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription}
  canonicalUrl={canonicalUrl}
>
  <Header />

  <!-- PAGE-SPECIFIC SEO SCHEMAS (Service & BreadcrumbList) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Industrial Engineering Consulting for Garment Factories",
    "serviceType": "Apparel Industrial Engineering and Factory Productivity Consulting",
    "provider": {
      "@type": "ProfessionalService",
      "name": "Cent Edge Consulting Pvt Ltd",
      "url": "https://centedge.co.in"
    },
    "areaServed": [
      {"@type": "Country", "name": "India"},
      {"@type": "Country", "name": "Bangladesh"},
      {"@type": "Country", "name": "Jordan"},
      {"@type": "Country", "name": "Vietnam"}
    ],
    "description": "Scientific Industrial Engineering advisory for garment factories. Optimize SMV standards, line balancing, machine-to-man ratios, and line throughput.",
    "url": "https://centedge.co.in/solutions/industrial-engineering/"
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://centedge.co.in/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Solutions",
        "item": "https://centedge.co.in/solutions/"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Industrial Engineering",
        "item": "https://centedge.co.in/solutions/industrial-engineering/"
      }
    ]
  }
  </script>


  <!-- BREADCRUMB NAVIGATION -->
  <nav class="breadcrumb-bar" aria-label="Breadcrumb">
    <div class="container">
      <ol class="breadcrumb-list">
        <li><a href="/">Home</a></li>
        <li class="breadcrumb-separator">/</li>
        <li><a href="/solutions/">Solutions</a></li>
        <li class="breadcrumb-separator">/</li>
        <li class="breadcrumb-current" aria-current="page">Industrial Engineering Excellence</li>
      </ol>
    </div>
  </nav>

  <main class="page-wrapper">
    <!-- ============================================================ -->
    <!-- 1. HERO SECTION WITH FLAT ILLUSTRATION & METRIC CHIPS -->
    <!-- ============================================================ -->
    <section class="hero-section">
      <div class="container hero-container">
        <div class="hero-content">
          <div class="hero-badge">
            <span class="badge-dot"></span>
            <span>Apparel Industrial Engineering &bull; Productivity &amp; Throughput</span>
          </div>
          <h1 class="hero-title">
            Convert Industrial Engineering into <em>Measurable</em> Productivity &amp; Throughput
          </h1>
          <p class="hero-desc">
            A structured Industrial Engineering system that connects operation methods, standard time (SMV), line capacity, manpower, and material flow directly to shop-floor profitability.
          </p>
          <div class="hero-actions">
            <a href="/contact/" class="btn-primary">
              <span>Discuss Your IE Transformation</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
            <a href="https://wa.me/919901422066?text=Hi%20Cent%20Edge%20team,%20we%20want%20to%20discuss%20Industrial%20Engineering%20consulting%20for%20our%20garment%20factory" target="_blank" rel="noopener noreferrer" class="btn-secondary">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#25D366" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
              </svg>
              <span>Chat with IE Specialist</span>
            </a>
          </div>

          <div class="hero-trust-row">
            <div class="trust-badge-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Scientific PMTS &amp; GSD Standards</span>
            </div>
            <div class="trust-badge-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Proven Across 100+ Apparel Lines</span>
            </div>
          </div>
        </div>

        <div class="hero-visual">
          <div class="hero-image-wrapper">
            <img 
              src="/images/pillar-ie-training.jpg" 
              alt="Industrial Engineering Excellence in Garment Plant" 
              class="hero-illustration"
              loading="eager"
            />
          </div>
        </div>
      </div>

      <!-- KEY RESULTS & BENCHMARKS STRIP -->
      <div class="results-ticker-strip">
        <div class="container">
          <!-- Live Eyebrow Header -->
          <div class="ticker-header-bar">
            <div class="ticker-badge-live">
              <span class="live-dot-ping"></span>
              <span class="live-badge-text">VERIFIED SHOP-FLOOR BENCHMARKS</span>
            </div>
            <div class="ticker-header-trust">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              <span>Documented Across 100+ Factory Engagements</span>
            </div>
          </div>

          <!-- 4 Advanced Metric Cards -->
          <div class="ticker-inner">
            <!-- Card 1 -->
            <div class="ticker-card">
              <div class="card-accent-gradient"></div>
              <div class="ticker-card-header">
                <span class="ticker-pill pill-blue">Productivity</span>
                <div class="ticker-icon-wrap wrap-blue">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="20" x2="18" y2="10"></line>
                    <line x1="12" y1="20" x2="12" y2="4"></line>
                    <line x1="6" y1="20" x2="6" y2="14"></line>
                    <path d="M4 8l5-5 5 5 6-6"></path>
                    <polyline points="16 2 20 2 20 6"></polyline>
                  </svg>
                </div>
              </div>
              <div class="ticker-stat-block">
                <div class="ticker-num">
                  <span class="num-val">15<span class="num-dash">&ndash;</span>25</span><span class="num-suffix">%</span>
                </div>
              </div>
              <h4 class="ticker-title">Productivity &amp; Daily Output</h4>
              <p class="ticker-desc">Sustained line output uplift achieved through line balancing and method re-engineering.</p>
              <div class="ticker-card-footer">
                <span class="footer-chip">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>GSD / SAM Calibrated</span>
                </span>
              </div>
            </div>

            <!-- Card 2 -->
            <div class="ticker-card">
              <div class="card-accent-gradient"></div>
              <div class="ticker-card-header">
                <span class="ticker-pill pill-indigo">Labor Efficiency</span>
                <div class="ticker-icon-wrap wrap-indigo">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                  </svg>
                </div>
              </div>
              <div class="ticker-stat-block">
                <div class="ticker-num">
                  <span class="num-val">10<span class="num-dash">&ndash;</span>18</span><span class="num-suffix">%</span>
                </div>
              </div>
              <h4 class="ticker-title">Reduction in MMR Ratio</h4>
              <p class="ticker-desc">Eliminating redundant helpers and manual line feeders through smart workstation flow.</p>
              <div class="ticker-card-footer">
                <span class="footer-chip">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>Direct Labor Savings</span>
                </span>
              </div>
            </div>

            <!-- Card 3 -->
            <div class="ticker-card">
              <div class="card-accent-gradient"></div>
              <div class="ticker-card-header">
                <span class="ticker-pill pill-emerald">Throughput</span>
                <div class="ticker-icon-wrap wrap-emerald">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="23 4 23 10 17 10"></polyline>
                    <polyline points="1 20 1 14 7 14"></polyline>
                    <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                  </svg>
                </div>
              </div>
              <div class="ticker-stat-block">
                <div class="ticker-num">
                  <span class="num-val">30</span><span class="num-suffix">%</span>
                </div>
              </div>
              <h4 class="ticker-title">Lower In-Line WIP</h4>
              <p class="ticker-desc">Compressing bundle cycle times and preventing choke points between critical operations.</p>
              <div class="ticker-card-footer">
                <span class="footer-chip">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>Faster Floor Lead-Times</span>
                </span>
              </div>
            </div>

            <!-- Card 4 -->
            <div class="ticker-card">
              <div class="card-accent-gradient"></div>
              <div class="ticker-card-header">
                <span class="ticker-pill pill-amber">Costing Precision</span>
                <div class="ticker-icon-wrap wrap-amber">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <circle cx="12" cy="12" r="6"></circle>
                    <circle cx="12" cy="12" r="2"></circle>
                  </svg>
                </div>
              </div>
              <div class="ticker-stat-block">
                <div class="ticker-num">
                  <span class="num-val">95</span><span class="num-suffix">%+</span>
                </div>
              </div>
              <h4 class="ticker-title">SMV &amp; Costing Accuracy</h4>
              <p class="ticker-desc">Scientific minute standards eliminate delivery delays and order undercosting.</p>
              <div class="ticker-card-footer">
                <span class="footer-chip">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>Audit-Grade Precision</span>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 2. SECTION 2: WHY FACTORIES UNDERPERFORM (4 FLAT ILLUSTRATIONS) -->
    <!-- ============================================================ -->
    <section class="section section-challenges">
      <div class="container">
        <div class="section-header text-center">
          <span class="section-tag section-tag-danger">Operational Bottlenecks</span>
          <h2 class="section-title">Why Apparel Factories Underperform</h2>
          <p class="section-subtitle">
            Factories often possess adequate machinery and manpower but fail to realize their true capacity because standards are weak, lines are unbalanced, and improvement actions are not sustained.
          </p>
        </div>

        <div class="challenges-grid">
          <!-- Card 1 -->
          <div class="challenge-card">
            <div class="challenge-img-box">
              <!-- Flat Vector SVG: Unreliable SMV -->
              <svg viewBox="0 0 280 180" class="flat-vector-art" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="280" height="180" rx="12" fill="#f8fafc"/>
                <!-- Background grid lines -->
                <line x1="40" y1="140" x2="240" y2="140" stroke="#e2e8f0" stroke-width="2"/>
                <line x1="40" y1="100" x2="240" y2="100" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="4 4"/>
                <line x1="40" y1="60" x2="240" y2="60" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="4 4"/>
                <!-- Erratic line -->
                <path d="M40 120 L80 65 L120 130 L160 55 L200 110 L240 70" stroke="#ef4444" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                <!-- Target baseline -->
                <line x1="40" y1="85" x2="240" y2="85" stroke="#2563a8" stroke-width="2" stroke-dasharray="6 6"/>
                <!-- Stopwatch symbol -->
                <circle cx="140" cy="50" r="26" fill="#ffffff" stroke="#ef4444" stroke-width="3"/>
                <path d="M140 20 V24 M136 20 H144" stroke="#ef4444" stroke-width="3" stroke-linecap="round"/>
                <polyline points="140 38 140 50 148 50" stroke="#ef4444" stroke-width="2.5" stroke-linecap="round"/>
                <!-- Alert Badge -->
                <rect x="180" y="24" width="70" height="24" rx="6" fill="#fef2f2" stroke="#ef4444" stroke-width="1"/>
                <text x="215" y="40" font-family="Inter, sans-serif" font-size="10" font-weight="700" fill="#dc2626" text-anchor="middle">&plusmn;28% Delta</text>
              </svg>
              <span class="challenge-num">01</span>
            </div>
            <div class="challenge-body">
              <span class="challenge-pill pill-danger">Standards Flaw</span>
              <h3 class="challenge-heading">Unreliable or Inconsistent SMV Standards</h3>
              <p class="challenge-text">
                Standard Allowed Minutes based on guesswork or crude stopwatches create friction between merchandising, planning, and the sewing floor, causing unrealistic commitments and disputed line targets.
              </p>
              <div class="challenge-impact">
                <strong>Impact:</strong> Inaccurate capacity planning and distorted product costing.
              </div>
            </div>
          </div>

          <!-- Card 2 -->
          <div class="challenge-card">
            <div class="challenge-img-box">
              <!-- Flat Vector SVG: Unbalanced Line & Bottleneck -->
              <svg viewBox="0 0 280 180" class="flat-vector-art" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="280" height="180" rx="12" fill="#f8fafc"/>
                <!-- Flow line -->
                <path d="M30 90 H250" stroke="#cbd5e1" stroke-width="4" stroke-linecap="round"/>
                <!-- Station 1 (Normal) -->
                <circle cx="55" cy="90" r="18" fill="#e0f2fe" stroke="#2563a8" stroke-width="2.5"/>
                <text x="55" y="94" font-family="Inter" font-size="11" font-weight="700" fill="#1a2e4a" text-anchor="middle">OP 1</text>
                <!-- Station 2: Bottleneck -->
                <circle cx="120" cy="90" r="22" fill="#fef2f2" stroke="#dc2626" stroke-width="3"/>
                <text x="120" y="94" font-family="Inter" font-size="11" font-weight="800" fill="#dc2626" text-anchor="middle">BOT</text>
                <!-- Piled Up WIP Bundles -->
                <rect x="98" y="40" width="18" height="12" rx="2" fill="#fca5a5" stroke="#ef4444"/>
                <rect x="104" y="24" width="18" height="12" rx="2" fill="#fca5a5" stroke="#ef4444"/>
                <rect x="124" y="32" width="18" height="12" rx="2" fill="#fca5a5" stroke="#ef4444"/>
                <!-- Station 3: Starved -->
                <circle cx="185" cy="90" r="18" fill="#f1f5f9" stroke="#94a3b8" stroke-width="2" stroke-dasharray="4 4"/>
                <text x="185" y="94" font-family="Inter" font-size="11" font-weight="700" fill="#64748b" text-anchor="middle">OP 3</text>
                <!-- Station 4: Normal -->
                <circle cx="245" cy="90" r="18" fill="#e0f2fe" stroke="#2563a8" stroke-width="2.5"/>
                <text x="245" y="94" font-family="Inter" font-size="11" font-weight="700" fill="#1a2e4a" text-anchor="middle">OP 4</text>
                <!-- Badge -->
                <rect x="75" y="132" width="130" height="24" rx="6" fill="#fffbeb" stroke="#f59e0b"/>
                <text x="140" y="148" font-family="Inter" font-size="10" font-weight="700" fill="#b45309" text-anchor="middle">Severe Line Starvation</text>
              </svg>
              <span class="challenge-num">02</span>
            </div>
            <div class="challenge-body">
              <span class="challenge-pill pill-amber">Flow Bottleneck</span>
              <h3 class="challenge-heading">Unbalanced Lines &amp; Excess WIP Accumulation</h3>
              <p class="challenge-text">
                Without pitch diagrams and tactical operator allocation, lines become choked with WIP bundles at critical operations while downstream operators sit idle waiting for pieces.
              </p>
              <div class="challenge-impact">
                <strong>Impact:</strong> Erratic hourly production and long bundle dwell times.
              </div>
            </div>
          </div>

          <!-- Card 3 -->
          <div class="challenge-card">
            <div class="challenge-img-box">
              <!-- Flat Vector SVG: Inefficient Motion & Ergonomics -->
              <svg viewBox="0 0 280 180" class="flat-vector-art" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="280" height="180" rx="12" fill="#f8fafc"/>
                <!-- Sewing Table -->
                <rect x="60" y="80" width="160" height="70" rx="8" fill="#ffffff" stroke="#1e293b" stroke-width="2.5"/>
                <!-- Sewing Machine Silhouette -->
                <rect x="130" y="55" width="60" height="30" rx="4" fill="#2563a8"/>
                <rect x="175" y="65" width="20" height="35" rx="3" fill="#1a2e4a"/>
                <!-- Operator -->
                <circle cx="110" cy="115" r="14" fill="#f47957"/>
                <!-- Chaotic Reach Path (Spaghetti Motion) -->
                <path d="M110 115 C70 90, 50 60, 80 40 C110 20, 150 30, 180 50 C210 70, 230 110, 190 125" stroke="#ef4444" stroke-width="2" stroke-dasharray="4 4"/>
                <circle cx="80" cy="40" r="4" fill="#ef4444"/>
                <circle cx="180" cy="50" r="4" fill="#ef4444"/>
                <!-- Wasted Motion Label -->
                <rect x="25" y="18" width="115" height="22" rx="6" fill="#fef2f2" stroke="#ef4444"/>
                <text x="82" y="33" font-family="Inter" font-size="9.5" font-weight="700" fill="#dc2626" text-anchor="middle">Excessive Reach: 75cm</text>
              </svg>
              <span class="challenge-num">03</span>
            </div>
            <div class="challenge-body">
              <span class="challenge-pill pill-warning">Motion Waste</span>
              <h3 class="challenge-heading">Inefficient Methods &amp; Workplace Layout</h3>
              <p class="challenge-text">
                Operators waste up to 25% of cycle time on awkward reaches, repetitive repositioning, unnecessary fabric folds, and poor bin presentation that drains operator energy and speed.
              </p>
              <div class="challenge-impact">
                <strong>Impact:</strong> Operator fatigue and preventable cycle time inflation.
              </div>
            </div>
          </div>

          <!-- Card 4 -->
          <div class="challenge-card">
            <div class="challenge-img-box">
              <!-- Flat Vector SVG: MMR & Manpower Bloat -->
              <svg viewBox="0 0 280 180" class="flat-vector-art" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="280" height="180" rx="12" fill="#f8fafc"/>
                <!-- Balance Scale Base -->
                <path d="M140 145 V55" stroke="#1e293b" stroke-width="4"/>
                <path d="M100 155 H180" stroke="#1e293b" stroke-width="5" stroke-linecap="round"/>
                <!-- Fulcrum bar tilted -->
                <path d="M60 85 L220 50" stroke="#2563a8" stroke-width="4" stroke-linecap="round"/>
                <!-- Left Plate (Heavy Manpower) -->
                <line x1="60" y1="85" x2="60" y2="115" stroke="#64748b" stroke-width="1.5"/>
                <rect x="35" y="115" width="50" height="14" rx="3" fill="#fef2f2" stroke="#ef4444"/>
                <!-- 3 Support Staff Icons -->
                <circle cx="45" cy="105" r="6" fill="#dc2626"/>
                <circle cx="60" cy="105" r="6" fill="#dc2626"/>
                <circle cx="75" cy="105" r="6" fill="#dc2626"/>
                <!-- Right Plate (Output) -->
                <line x1="220" y1="50" x2="220" y2="80" stroke="#64748b" stroke-width="1.5"/>
                <rect x="195" y="80" width="50" height="14" rx="3" fill="#e0f2fe" stroke="#2563a8"/>
                <circle cx="220" cy="70" r="7" fill="#2563a8"/>
                <!-- MMR High Badge -->
                <rect x="155" y="18" width="105" height="24" rx="6" fill="#fef2f2" stroke="#ef4444"/>
                <text x="207" y="34" font-family="Inter" font-size="10" font-weight="700" fill="#dc2626" text-anchor="middle">MMR: 1.65 (Bloated)</text>
              </svg>
              <span class="challenge-num">04</span>
            </div>
            <div class="challenge-body">
              <span class="challenge-pill pill-danger">Cost Inflation</span>
              <h3 class="challenge-heading">High Man-to-Machine Ratio &amp; Support Bloat</h3>
              <p class="challenge-text">
                Excess helpers, line-feeders, and quality checkers are added to mask underlying inefficiencies, driving up overhead costs without delivering higher line throughput.
              </p>
              <div class="challenge-impact">
                <strong>Impact:</strong> High labor cost per garment and diluted margins.
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 3. SECTION 3: THE 6 CORE IE DELIVERY MODULES -->
    <!-- ============================================================ -->
    <section class="section section-modules">
      <div class="container">
        <div class="section-header text-center">
          <span class="section-tag">Cent Edge IE System</span>
          <h2 class="section-title">What We Deliver: 6 Integrated IE Disciplines</h2>
          <p class="section-subtitle">
            A comprehensive, facts-driven Industrial Engineering framework tailored for high-speed apparel cutting, sewing, and finishing lines.
          </p>
        </div>

        <div class="modules-grid">
          <!-- Module 1 -->
          <div class="module-card">
            <div class="module-art-box">
              <svg viewBox="0 0 320 180" class="module-svg" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="320" height="180" rx="14" fill="#eff6ff"/>
                <!-- Spreadsheet / Standard Database -->
                <rect x="35" y="30" width="180" height="120" rx="8" fill="#ffffff" stroke="#2563a8" stroke-width="2"/>
                <line x1="35" y1="60" x2="215" y2="60" stroke="#bfdbfe" stroke-width="2"/>
                <line x1="35" y1="90" x2="215" y2="90" stroke="#eff6ff" stroke-width="1.5"/>
