---
// src/pages/solutions/smart-factory/index.astro
// Flagship Solution Page: Smart Factory Consulting for Apparel Manufacturers
// Built with bespoke technical vector diagrams, scannable consulting copy, and 100% visual alignment with Industrial Engineering & 5S pages.

import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const pageTitle = "Smart Factory Consulting for Apparel Manufacturers | Cent Edge Bangalore";
const pageDescription = "Transform garment manufacturing with a connected, scientific Smart Factory. Cent Edge unifies MES telemetry, automated cutting, deskilling jigs, internal logistics, and digital quality into shop-floor profitability.";
const canonicalUrl = "https://centedge.co.in/solutions/smart-factory/";
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription}
  canonicalUrl={canonicalUrl}
>
  <Header />

  <!-- PAGE-SPECIFIC SEO SCHEMAS (Service & BreadcrumbList) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Smart Factory Consulting for Apparel Manufacturers",
    "serviceType": "Apparel Industry 4.0 and Smart Factory Consulting",
    "provider": {
      "@type": "ProfessionalService",
      "name": "Cent Edge Consulting Pvt Ltd",
      "url": "https://centedge.co.in"
    },
    "areaServed": [
      {"@type": "Country", "name": "India"},
      {"@type": "Country", "name": "Bangladesh"},
      {"@type": "Country", "name": "Jordan"},
      {"@type": "Country", "name": "Vietnam"}
    ],
    "description": "Scientific Smart Factory advisory for garment manufacturers. Connect MES telemetry, smart cutting rooms, deskilling automation, internal material handling, and digital quality systems.",
    "url": "https://centedge.co.in/solutions/smart-factory/"
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://centedge.co.in/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Solutions",
        "item": "https://centedge.co.in/solutions/"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Smart Factory",
        "item": "https://centedge.co.in/solutions/smart-factory/"
      }
    ]
  }
  </script>

  <!-- BREADCRUMB NAVIGATION -->
  <nav class="breadcrumb-bar" aria-label="Breadcrumb">
    <div class="container">
      <ol class="breadcrumb-list">
        <li><a href="/">Home</a></li>
        <li class="breadcrumb-separator">/</li>
        <li><a href="/solutions/">Solutions</a></li>
        <li class="breadcrumb-separator">/</li>
        <li class="breadcrumb-current" aria-current="page">Smart Factory Consulting</li>
      </ol>
    </div>
  </nav>

  <main class="page-wrapper">
    <!-- ============================================================ -->
    <!-- 1. HERO SECTION WITH IMAGE & METRIC CHIPS -->
    <!-- ============================================================ -->
    <section class="hero-section">
      <div class="container hero-container">
        <div class="hero-content">
          <div class="hero-badge">
            <span class="badge-dot"></span>
            <span>Apparel Industry 4.0 &bull; Connected Shop-Floor Intelligence</span>
          </div>
          <h1 class="hero-title">
            Convert Shop-Floor Telemetry into <em>Measurable</em> Apparel Profitability
          </h1>
          <p class="hero-desc">
            A vendor-neutral Smart Factory operating system that integrates real-time MES machine telemetry, automated cutting, deskilling attachments, and digital quality control directly to your plant's P&amp;L.
          </p>
          <div class="hero-actions">
            <a href="/contact/" class="btn-primary">
              <span>Discuss Your Smart Factory Roadmap</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
            <a href="https://wa.me/919901422066?text=Hi%20Cent%20Edge%20team,%20we%20want%20to%20discuss%20Smart%20Factory%20consulting%20for%20our%20garment%20factory" target="_blank" rel="noopener noreferrer" class="btn-secondary">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#25D366" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
              </svg>
              <span>Chat with Smart Factory Specialist</span>
            </a>
          </div>

          <div class="hero-trust-row">
            <div class="trust-badge-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Proven Across 100+ Apparel Lines</span>
            </div>
            <div class="trust-badge-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Measurable Pilot ROI in 90 Days</span>
            </div>
          </div>
        </div>

        <div class="hero-visual">
          <div class="hero-image-wrapper">
            <img 
              src="/images/pillar-smart-factory.jpg" 
              alt="Smart Factory Consulting in Garment Plant" 
              class="hero-illustration"
              loading="eager"
            />
          </div>
        </div>
      </div>

      <!-- KEY RESULTS & BENCHMARKS STRIP -->
      <div class="results-ticker-strip">
        <div class="container">
          <div class="ticker-header-bar">
            <div class="ticker-badge-live">
              <span class="live-dot-ping"></span>
              <span class="live-badge-text">VERIFIED SHOP-FLOOR BENCHMARKS</span>
            </div>
            <div class="ticker-header-trust">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              <span>Documented Across 100+ Factory Engagements</span>
            </div>
          </div>

          <div class="ticker-cards-row">
            <div class="ticker-card">
              <div class="ticker-card-top">
                <span class="ticker-pill pill-blue">Productivity</span>
                <div class="ticker-icon-wrap wrap-blue">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="20" x2="18" y2="10"></line>
                    <line x1="12" y1="20" x2="12" y2="4"></line>
                    <line x1="6" y1="20" x2="6" y2="14"></line>
                  </svg>
                </div>
              </div>
              <div class="ticker-card-number">+18–30%</div>
              <div class="ticker-card-label">Line Output Uplift</div>
              <div class="ticker-card-footer">
                <span class="footer-chip">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>MES Pacing Synchronized</span>
                </span>
              </div>
            </div>

            <div class="ticker-card">
              <div class="ticker-card-top">
                <span class="ticker-pill pill-indigo">Traceability</span>
                <div class="ticker-icon-wrap wrap-indigo">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                  </svg>
                </div>
              </div>
              <div class="ticker-card-number">100%</div>
              <div class="ticker-card-label">Real-Time WIP Visibility</div>
              <div class="ticker-card-footer">
                <span class="footer-chip">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>Zero Blind WIP Piles</span>
                </span>
              </div>
            </div>

            <div class="ticker-card">
              <div class="ticker-card-top">
                <span class="ticker-pill pill-emerald">Downtime Cut</span>
                <div class="ticker-icon-wrap wrap-emerald">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                </div>
              </div>
              <div class="ticker-card-number">15–25%</div>
              <div class="ticker-card-label">NPT &amp; Stoppages Cut</div>
              <div class="ticker-card-footer">
                <span class="footer-chip">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>Instant Andon Alerts</span>
                </span>
              </div>
            </div>

            <div class="ticker-card">
              <div class="ticker-card-top">
                <span class="ticker-pill pill-amber">Rapid Payback</span>
                <div class="ticker-icon-wrap wrap-amber">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="1" x2="12" y2="23"></line>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                  </svg>
                </div>
              </div>
              <div class="ticker-card-number">3–6 Mo</div>
              <div class="ticker-card-label">Measurable Technology ROI</div>
              <div class="ticker-card-footer">
                <span class="footer-chip">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>P&amp;L Driven CAPEX</span>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 2. SECTION 2: SHOP-FLOOR CHALLENGES (4 BESPOKE FLAT VECTOR ART) -->
    <!-- ============================================================ -->
    <section class="section section-challenges">
      <div class="container">
        <div class="section-header text-center">
          <span class="section-tag section-tag-danger">Industry Bottlenecks</span>
          <h2 class="section-title">Where Disconnected Tech &amp; Blind Spots Bleed Plant Margins</h2>
          <p class="section-subtitle">
            Most technology adoption in garment factories is bought in isolation without an integrated data thread, creating digital silos and zero compounding ROI.
          </p>
        </div>

        <div class="challenges-grid">
          <!-- Card 1 -->
          <div class="challenge-card">
            <div class="challenge-img-box">
              <svg viewBox="0 0 280 180" class="flat-vector-art" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="280" height="180" rx="12" fill="#f8fafc"/>
                <!-- Coordinate Grid -->
                <line x1="40" y1="140" x2="240" y2="140" stroke="#e2e8f0" stroke-width="2"/>
                <line x1="40" y1="100" x2="240" y2="100" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="4 4"/>
                <line x1="40" y1="60" x2="240" y2="60" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="4 4"/>
                <line x1="40" y1="40" x2="40" y2="140" stroke="#cbd5e1" stroke-width="2"/>
                <!-- Escalating Cost Curve -->
                <path d="M40 120 Q110 110 160 70 T240 40" stroke="#ef4444" stroke-width="3.5" fill="none" stroke-linecap="round"/>
                <!-- Stagnant FOB Price Line -->
                <line x1="40" y1="95" x2="240" y2="95" stroke="#2563a8" stroke-width="2.5" stroke-dasharray="6 6"/>
                <!-- Squeeze Shaded Area -->
                <polygon points="160,70 240,40 240,95 160,95" fill="rgba(239, 68, 68, 0.12)"/>
                <!-- Badges -->
                <rect x="145" y="65" width="85" height="20" rx="4" fill="#fee2e2" stroke="#ef4444"/>
                <text x="187" y="79" font-family="Inter, sans-serif" font-size="9" font-weight="700" fill="#dc2626" text-anchor="middle">MARGIN SQUEEZE</text>
                <text x="240" y="32" font-family="Inter, sans-serif" font-size="9" font-weight="700" fill="#ef4444" text-anchor="end">Wages &amp; Overheads</text>
                <text x="240" y="112" font-family="Inter, sans-serif" font-size="9" font-weight="600" fill="#2563a8" text-anchor="end">Customer FOB Price</text>
              </svg>
              <span class="challenge-num">01</span>
            </div>
            <div class="challenge-body">
              <span class="challenge-pill pill-danger">Cost Inflation</span>
              <h3 class="challenge-heading">Cost Without Pricing Power</h3>
              <p class="challenge-text">
                Wages, raw materials, and factory utilities escalate year-on-year, while buyer FOB pricing remains compressed or flat across global retail orders.
              </p>
              <div class="challenge-impact">
                <strong>Impact:</strong> Operating margins eroded by 2–4% annually without live productivity tracking.
              </div>
            </div>
          </div>

          <!-- Card 2 -->
          <div class="challenge-card">
            <div class="challenge-img-box">
              <svg viewBox="0 0 280 180" class="flat-vector-art" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="280" height="180" rx="12" fill="#f8fafc"/>
                <!-- Baseline -->
                <line x1="35" y1="140" x2="245" y2="140" stroke="#cbd5e1" stroke-width="2"/>
                <!-- Region Bars -->
                <rect x="50" y="90" width="36" height="50" rx="4" fill="#cbd5e1"/>
                <text x="68" y="156" font-family="Inter, sans-serif" font-size="9.5" font-weight="600" fill="#64748b" text-anchor="middle">Legacy</text>
                <rect x="110" y="65" width="36" height="75" rx="4" fill="#60a5fa"/>
                <text x="128" y="156" font-family="Inter, sans-serif" font-size="9.5" font-weight="600" fill="#2563a8" text-anchor="middle">Vietnam</text>
                <rect x="170" y="40" width="36" height="100" rx="4" fill="#10b981"/>
                <text x="188" y="156" font-family="Inter, sans-serif" font-size="9.5" font-weight="700" fill="#047857" text-anchor="middle">Smart Hub</text>
                <!-- Gap Indicator Arrow -->
                <path d="M68 80 L128 55 L188 30" stroke="#10b981" stroke-width="2" stroke-dasharray="4 4"/>
                <circle cx="188" cy="30" r="4" fill="#10b981"/>
                <!-- Alert Badge -->
                <rect x="60" y="24" width="160" height="22" rx="5" fill="#ecfdf5" stroke="#10b981"/>
                <text x="140" y="39" font-family="Inter, sans-serif" font-size="9" font-weight="700" fill="#047857" text-anchor="middle">+35% Regional Tech Scale</text>
              </svg>
              <span class="challenge-num">02</span>
            </div>
            <div class="challenge-body">
              <span class="challenge-pill pill-amber">Regional Gap</span>
              <h3 class="challenge-heading">Intensifying Hub Competition</h3>
              <p class="challenge-text">
                Competitor hubs in Vietnam, Bangladesh, and Cambodia scale automated cutting and digital MES to outprice conventional, unmonitored plants.
              </p>
              <div class="challenge-impact">
                <strong>Impact:</strong> Buyer order migration to digitized regional apparel competitors.
              </div>
            </div>
          </div>

          <!-- Card 3 -->
          <div class="challenge-card">
            <div class="challenge-img-box">
              <svg viewBox="0 0 280 180" class="flat-vector-art" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="280" height="180" rx="12" fill="#f8fafc"/>
                <!-- Baseline -->
                <line x1="30" y1="135" x2="250" y2="135" stroke="#cbd5e1" stroke-width="2"/>
                <!-- Operator Variance Bell Curve -->
                <path d="M45 135 Q100 135 120 70 T140 35 Q160 35 175 70 T235 135" stroke="#f59e0b" stroke-width="3" fill="none"/>
                <!-- Variance Range Indicators -->
                <line x1="95" y1="45" x2="95" y2="135" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="3 3"/>
                <line x1="185" y1="45" x2="185" y2="135" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="3 3"/>
                <!-- Operator Silhouette -->
                <circle cx="140" cy="55" r="12" fill="#1a2e4a"/>
                <path d="M125 80 C125 70 155 70 155 80 V100 H125 Z" fill="#2563a8"/>
                <!-- Badge -->
                <rect x="75" y="18" width="130" height="22" rx="5" fill="#fef2f2" stroke="#ef4444"/>
                <text x="140" y="33" font-family="Inter, sans-serif" font-size="9" font-weight="700" fill="#dc2626" text-anchor="middle">&plusmn;35% Operator Variance</text>
              </svg>
              <span class="challenge-num">03</span>
            </div>
            <div class="challenge-body">
              <span class="challenge-pill pill-warning">Skill Scarcity</span>
              <h3 class="challenge-heading">Critical Operator Dependency</h3>
              <p class="challenge-text">
                Skilled sewing operators are increasingly scarce. Without standardized deskilling jigs and digital SOPs, line volatility remains unacceptably high.
              </p>
              <div class="challenge-impact">
                <strong>Impact:</strong> Heavy efficiency dips during style changeovers and high absenteeism.
              </div>
            </div>
          </div>

          <!-- Card 4 -->
          <div class="challenge-card">
            <div class="challenge-img-box">
              <svg viewBox="0 0 280 180" class="flat-vector-art" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="280" height="180" rx="12" fill="#f8fafc"/>
                <!-- 3 Silo Boxes -->
                <rect x="35" y="55" width="55" height="50" rx="6" fill="#ffffff" stroke="#64748b" stroke-width="2"/>
                <text x="62" y="78" font-family="Inter, sans-serif" font-size="9" font-weight="700" fill="#1a2e4a" text-anchor="middle">CAD</text>
                <text x="62" y="93" font-family="Inter, sans-serif" font-size="8" font-weight="500" fill="#64748b" text-anchor="middle">Silo 1</text>

                <rect x="112" y="55" width="55" height="50" rx="6" fill="#ffffff" stroke="#64748b" stroke-width="2"/>
                <text x="139" y="78" font-family="Inter, sans-serif" font-size="9" font-weight="700" fill="#1a2e4a" text-anchor="middle">SEW</text>
                <text x="139" y="93" font-family="Inter, sans-serif" font-size="8" font-weight="500" fill="#64748b" text-anchor="middle">Silo 2</text>

                <rect x="190" y="55" width="55" height="50" rx="6" fill="#ffffff" stroke="#64748b" stroke-width="2"/>
                <text x="217" y="78" font-family="Inter, sans-serif" font-size="9" font-weight="700" fill="#1a2e4a" text-anchor="middle">PACK</text>
                <text x="217" y="93" font-family="Inter, sans-serif" font-size="8" font-weight="500" fill="#64748b" text-anchor="middle">Silo 3</text>

                <!-- Broken Links with red X -->
                <line x1="90" y1="80" x2="112" y2="80" stroke="#ef4444" stroke-width="2" stroke-dasharray="3 3"/>
                <circle cx="101" cy="80" r="7" fill="#fee2e2" stroke="#ef4444"/>
                <text x="101" y="84" font-family="Inter, sans-serif" font-size="9" font-weight="800" fill="#dc2626" text-anchor="middle">&times;</text>

                <line x1="167" y1="80" x2="190" y2="80" stroke="#ef4444" stroke-width="2" stroke-dasharray="3 3"/>
                <circle cx="178" cy="80" r="7" fill="#fee2e2" stroke="#ef4444"/>
                <text x="178" y="84" font-family="Inter, sans-serif" font-size="9" font-weight="800" fill="#dc2626" text-anchor="middle">&times;</text>

                <!-- Badge -->
                <rect x="70" y="130" width="140" height="22" rx="5" fill="#fef2f2" stroke="#ef4444"/>
                <text x="140" y="145" font-family="Inter, sans-serif" font-size="9" font-weight="700" fill="#dc2626" text-anchor="middle">No Integrated Data Thread</text>
              </svg>
              <span class="challenge-num">04</span>
            </div>
            <div class="challenge-body">
              <span class="challenge-pill pill-danger">Digital Blind Spots</span>
              <h3 class="challenge-heading">Disconnected Tech Silos</h3>
              <p class="challenge-text">
                Purchasing individual software tools or automated stations without an integrated data thread creates digital silos with zero compounding ROI.
              </p>
              <div class="challenge-impact">
                <strong>Impact:</strong> Expensive software shelfware and uncalibrated shop-floor bottlenecks.
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 3. SECTION 3: THE 6 CORE SMART FACTORY LEVERS (MODULES) -->
    <!-- ============================================================ -->
    <section class="section section-modules" id="levers">
      <div class="container">
        <div class="section-header text-center">
          <span class="section-tag section-tag-primary">The 6 Core Levers</span>
          <h2 class="section-title">The Foundational Levers of a Connected Garment Plant</h2>
          <p class="section-subtitle">
            From real-time machine telemetry to automated cutting and digital quality control, we build systems that synchronize your entire manufacturing value chain.
          </p>
        </div>

        <div class="modules-grid">
          <!-- Module 1: MES & Real-Time Machine Telemetry -->
          <div class="module-card">
            <div class="module-art-box">
              <svg viewBox="0 0 320 180" class="module-svg" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="320" height="180" rx="14" fill="#eff6ff"/>
                <!-- Machine Console Box -->
                <rect x="35" y="35" width="105" height="110" rx="8" fill="#ffffff" stroke="#2563a8" stroke-width="2"/>
                <rect x="47" y="48" width="81" height="34" rx="4" fill="#1a2e4a"/>
                <text x="87" y="69" font-family="Inter, sans-serif" font-size="13" font-weight="800" fill="#10b981" text-anchor="middle">94.2% OEE</text>
                <circle cx="58" cy="105" r="7" fill="#10b981"/>
                <text x="73" y="109" font-family="Inter, sans-serif" font-size="9" font-weight="700" fill="#1e293b">LIVE PACE</text>
                <rect x="47" y="122" width="81" height="12" rx="3" fill="#e0f2fe"/>
                <rect x="47" y="122" width="62" height="12" rx="3" fill="#2563a8"/>

                <!-- Telemetry Wave Link -->
                <path d="M140 90 H180" stroke="#2563a8" stroke-width="3" stroke-dasharray="4 4"/>
                <circle cx="160" cy="90" r="5" fill="#2563a8"/>

                <!-- Supervisor Tablet -->
                <rect x="185" y="35" width="100" height="110" rx="8" fill="#ffffff" stroke="#1e293b" stroke-width="2"/>
                <rect x="195" y="48" width="80" height="12" rx="3" fill="#f1f5f9"/>
                <text x="235" y="58" font-family="Inter, sans-serif" font-size="8.5" font-weight="700" fill="#1a2e4a" text-anchor="middle">LINE 04 BOTTLENECK</text>
                <!-- Live Bar Graph on Tablet -->
