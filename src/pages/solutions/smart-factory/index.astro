---
// src/pages/solutions/smart-factory/index.astro
// Flagship Solution Page: Smart Factory Consulting for Apparel Manufacturers
// Built with bespoke technical vector diagrams, scannable consulting copy, and 100% visual alignment with Industrial Engineering & 5S pages.

import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const pageTitle = "Smart Factory Consulting for Apparel Manufacturers | Cent Edge Bangalore";
const pageDescription = "Transform garment manufacturing with a connected, scientific Smart Factory. Cent Edge unifies MES telemetry, automated cutting, deskilling jigs, internal logistics, and digital quality into shop-floor profitability.";
const canonicalUrl = "https://centedge.co.in/solutions/smart-factory/";
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription}
  canonicalUrl={canonicalUrl}
>
  <Header />

  <!-- PAGE-SPECIFIC SEO SCHEMAS (Service & BreadcrumbList) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Smart Factory Consulting for Apparel Manufacturers",
    "serviceType": "Apparel Industry 4.0 and Smart Factory Consulting",
    "provider": {
      "@type": "ProfessionalService",
      "name": "Cent Edge Consulting Pvt Ltd",
      "url": "https://centedge.co.in"
    },
    "areaServed": [
      {"@type": "Country", "name": "India"},
      {"@type": "Country", "name": "Bangladesh"},
      {"@type": "Country", "name": "Jordan"},
      {"@type": "Country", "name": "Vietnam"}
    ],
    "description": "Scientific Smart Factory advisory for garment manufacturers. Connect MES telemetry, smart cutting rooms, deskilling automation, internal material handling, and digital quality systems.",
    "url": "https://centedge.co.in/solutions/smart-factory/"
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://centedge.co.in/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Solutions",
        "item": "https://centedge.co.in/solutions/"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Smart Factory",
        "item": "https://centedge.co.in/solutions/smart-factory/"
      }
    ]
  }
  </script>

  <!-- BREADCRUMB NAVIGATION -->
  <nav class="breadcrumb-bar" aria-label="Breadcrumb">
    <div class="container">
      <ol class="breadcrumb-list">
        <li><a href="/">Home</a></li>
        <li class="breadcrumb-separator">/</li>
        <li><a href="/solutions/">Solutions</a></li>
        <li class="breadcrumb-separator">/</li>
        <li class="breadcrumb-current" aria-current="page">Smart Factory Consulting</li>
      </ol>
    </div>
  </nav>

  <main class="page-wrapper">
    <!-- ============================================================ -->
    <!-- 1. HERO SECTION WITH IMAGE & METRIC CHIPS -->
    <!-- ============================================================ -->
    <section class="hero-section">
      <div class="container hero-container">
        <div class="hero-content">
          <div class="hero-badge">
            <span class="badge-dot"></span>
            <span>Apparel Industry 4.0 &bull; Connected Shop-Floor Intelligence</span>
          </div>
          <h1 class="hero-title">
            Convert Shop-Floor Telemetry into <em>Measurable</em> Apparel Profitability
          </h1>
          <p class="hero-desc">
            A vendor-neutral Smart Factory operating system that integrates real-time MES machine telemetry, automated cutting, deskilling attachments, and digital quality control directly to your plant's P&amp;L.
          </p>
          <div class="hero-actions">
            <a href="/contact/" class="btn-primary">
              <span>Discuss Your Smart Factory Roadmap</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
            <a href="https://wa.me/919901422066?text=Hi%20Cent%20Edge%20team,%20we%20want%20to%20discuss%20Smart%20Factory%20consulting%20for%20our%20garment%20factory" target="_blank" rel="noopener noreferrer" class="btn-secondary">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#25D366" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
              </svg>
              <span>Chat with Smart Factory Specialist</span>
            </a>
          </div>

          <div class="hero-trust-row">
            <div class="trust-badge-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Proven Across 100+ Apparel Lines</span>
            </div>
            <div class="trust-badge-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Measurable Pilot ROI in 90 Days</span>
            </div>
          </div>
        </div>

        <div class="hero-visual">
          <div class="hero-image-wrapper">
            <img 
              src="/images/pillar-smart-factory.jpg" 
              alt="Smart Factory Consulting in Garment Plant" 
              class="hero-illustration"
              loading="eager"
            />
          </div>
        </div>
      </div>

      <!-- KEY RESULTS & BENCHMARKS STRIP -->
      <div class="results-ticker-strip">
        <div class="container">
          <div class="ticker-header-bar">
            <div class="ticker-badge-live">
              <span class="live-dot-ping"></span>
              <span class="live-badge-text">VERIFIED SHOP-FLOOR BENCHMARKS</span>
            </div>
            <div class="ticker-header-trust">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              <span>Documented Across 100+ Factory Engagements</span>
            </div>
          </div>

          <div class="ticker-cards-row">
            <div class="ticker-card">
              <div class="ticker-card-top">
                <span class="ticker-pill pill-blue">Productivity</span>
                <div class="ticker-icon-wrap wrap-blue">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="20" x2="18" y2="10"></line>
                    <line x1="12" y1="20" x2="12" y2="4"></line>
                    <line x1="6" y1="20" x2="6" y2="14"></line>
                  </svg>
                </div>
              </div>
              <div class="ticker-card-number">+18–30%</div>
              <div class="ticker-card-label">Line Output Uplift</div>
              <div class="ticker-card-footer">
                <span class="footer-chip">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>MES Pacing Synchronized</span>
                </span>
              </div>
            </div>

            <div class="ticker-card">
              <div class="ticker-card-top">
                <span class="ticker-pill pill-indigo">Traceability</span>
                <div class="ticker-icon-wrap wrap-indigo">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                  </svg>
                </div>
              </div>
              <div class="ticker-card-number">100%</div>
              <div class="ticker-card-label">Real-Time WIP Visibility</div>
              <div class="ticker-card-footer">
                <span class="footer-chip">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>Zero Blind WIP Piles</span>
                </span>
              </div>
            </div>

            <div class="ticker-card">
              <div class="ticker-card-top">
                <span class="ticker-pill pill-emerald">Downtime Cut</span>
                <div class="ticker-icon-wrap wrap-emerald">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                </div>
              </div>
              <div class="ticker-card-number">15–25%</div>
              <div class="ticker-card-label">NPT &amp; Stoppages Cut</div>
              <div class="ticker-card-footer">
                <span class="footer-chip">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>Instant Andon Alerts</span>
                </span>
              </div>
            </div>

            <div class="ticker-card">
              <div class="ticker-card-top">
                <span class="ticker-pill pill-amber">Rapid Payback</span>
                <div class="ticker-icon-wrap wrap-amber">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="1" x2="12" y2="23"></line>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                  </svg>
                </div>
              </div>
              <div class="ticker-card-number">3–6 Mo</div>
              <div class="ticker-card-label">Measurable Technology ROI</div>
              <div class="ticker-card-footer">
                <span class="footer-chip">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>P&amp;L Driven CAPEX</span>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 2. SECTION 2: SHOP-FLOOR CHALLENGES -->
    <!-- ============================================================ -->
    <section class="section section-challenges">
      <div class="container">
        <div class="section-header text-center">
          <span class="section-tag section-tag-danger">Industry Bottlenecks</span>
          <h2 class="section-title">Where Disconnected Tech &amp; Blind Spots Bleed Plant Margins</h2>
          <p class="section-subtitle">
            Most technology adoption in garment factories is bought in isolation without an integrated data thread, creating digital silos and zero compounding ROI.
          </p>
        </div>

        <div class="challenges-grid">
          <!-- Card 1 -->
          <div class="challenge-card">
            <span class="card-faded-number" aria-hidden="true">01</span>
            <div class="card-content">
              <div class="card-icon"><i class="ti ti-trending-down"></i></div>
              <div class="card-accent-bar"></div>
              <span class="challenge-pill pill-cost">Cost Inflation</span>
              <h3 class="challenge-heading">Cost Without Pricing Power</h3>
              <p class="challenge-text">
                Wages, raw materials, and factory utilities escalate year-on-year, while buyer FOB pricing remains compressed or flat across global retail orders.
              </p>
              <div class="challenge-impact">
                <strong>Impact:</strong> Operating margins eroded by 2&ndash;4% annually without live productivity tracking.
              </div>
            </div>
          </div>

          <!-- Card 2 -->
          <div class="challenge-card">
            <span class="card-faded-number" aria-hidden="true">02</span>
            <div class="card-content">
              <div class="card-icon"><i class="ti ti-building-factory-2"></i></div>
              <div class="card-accent-bar"></div>
              <span class="challenge-pill pill-regional">Regional Gap</span>
              <h3 class="challenge-heading">Intensifying Hub Competition</h3>
              <p class="challenge-text">
                Competitor hubs in Vietnam, Bangladesh, and Cambodia scale automated cutting and digital MES to outprice conventional, unmonitored plants.
              </p>
              <div class="challenge-impact">
                <strong>Impact:</strong> Buyer order migration to digitized regional apparel competitors.
              </div>
            </div>
          </div>

          <!-- Card 3 -->
          <div class="challenge-card">
            <span class="card-faded-number" aria-hidden="true">03</span>
            <div class="card-content">
              <div class="card-icon"><i class="ti ti-user-off"></i></div>
              <div class="card-accent-bar"></div>
              <span class="challenge-pill pill-skill">Skill Scarcity</span>
              <h3 class="challenge-heading">Critical Operator Dependency</h3>
              <p class="challenge-text">
                Skilled sewing operators are increasingly scarce. Without standardized deskilling jigs and digital SOPs, line volatility remains unacceptably high.
              </p>
              <div class="challenge-impact">
                <strong>Impact:</strong> Heavy efficiency dips during style changeovers and high absenteeism.
              </div>
            </div>
          </div>

          <!-- Card 4 -->
          <div class="challenge-card">
            <span class="card-faded-number" aria-hidden="true">04</span>
            <div class="card-content">
              <div class="card-icon"><i class="ti ti-wifi-off"></i></div>
              <div class="card-accent-bar"></div>
              <span class="challenge-pill pill-digital">Digital Blind Spots</span>
              <h3 class="challenge-heading">Disconnected Tech Silos</h3>
              <p class="challenge-text">
                Purchasing individual software tools or automated stations without an integrated data thread creates digital silos with zero compounding ROI.
              </p>
              <div class="challenge-impact">
                <strong>Impact:</strong> Expensive software shelfware and uncalibrated shop-floor bottlenecks.
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 3. SECTION 3: THE 6 CORE SMART FACTORY LEVERS (MODULES) -->
    <!-- ============================================================ -->
    <section class="section section-modules" id="levers">
      <div class="container">
        <div class="section-header text-center">
          <span class="section-tag section-tag-primary">The 6 Core Levers</span>
          <h2 class="section-title">The Foundational Levers of a Connected Garment Plant</h2>
          <p class="section-subtitle">
            From real-time machine telemetry to automated cutting and digital quality control, we build systems that synchronize your entire manufacturing value chain.
          </p>
        </div>

        <div class="modules-grid">
          <!-- Module 1: MES & Real-Time Machine Telemetry -->
          <div class="module-card">
            <span class="card-faded-number" aria-hidden="true">01</span>
            <div class="card-content">
              <div class="card-icon"><i class="ti ti-device-analytics"></i></div>
              <div class="card-accent-bar"></div>
              <div class="module-badge">LEVER 01 &bull; FLOOR TELEMETRY</div>
              <h3 class="module-title">MES &amp; Real-Time Machine Telemetry</h3>
              <p class="module-desc">
                Digitize sewing floor execution with non-invasive IoT sensors and terminal tablets, turning static end-of-day reports into live hourly management control.
              </p>
              <ul class="module-list">
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1a3f6f" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Non-invasive optical &amp; needle-run sensors for instant cycle time logging</span></li>
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1a3f6f" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Real-time operator pacing screens displaying earned hours vs standard SAM</span></li>
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1a3f6f" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Instant Andon call buttons for mechanics, quality inspectors, and bundle feeders</span></li>
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1a3f6f" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Supervisor mobile dashboards alerting to line bottlenecks within 3 minutes</span></li>
              </ul>
              <div class="module-result-chip">
                <strong>Expected Impact:</strong> 8&ndash;15% efficiency recovery &amp; 30% lower non-productive time
              </div>
            </div>
          </div>

          <!-- Module 2: Connected Smart Cutting Room -->
          <div class="module-card">
            <span class="card-faded-number" aria-hidden="true">02</span>
            <div class="card-content">
              <div class="card-icon"><i class="ti ti-scissors"></i></div>
              <div class="card-accent-bar"></div>
              <div class="module-badge">LEVER 02 &bull; MATERIAL YIELD</div>
              <h3 class="module-title">Connected Smart Cutting Room</h3>
              <p class="module-desc">
                Connect CAD nesting software directly with automated fabric spreading and CNC cutters, capturing 60&ndash;70% of total garment cost where it is determined.
              </p>
              <ul class="module-list">
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1a3f6f" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg><span>End-bit management and roll length tracking eliminating cut-order overruns</span></li>
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1a3f6f" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Automated tensionless spreading synchronized to fabric stretch characteristics</span></li>
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1a3f6f" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg><span>CNC knife velocity calibration preventing ply-to-ply perimeter distortion</span></li>
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1a3f6f" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Automated ply-numbering and barcode ticket printing for line traceability</span></li>
              </ul>
              <div class="module-result-chip">
                <strong>Expected Impact:</strong> 1.5&ndash;3.0% fabric utilization savings &amp; zero shade mismatch
              </div>
            </div>
          </div>

          <!-- Module 3: Automation & Workstation Deskilling -->
          <div class="module-card">
            <span class="card-faded-number" aria-hidden="true">03</span>
            <div class="card-content">
              <div class="card-icon"><i class="ti ti-robot"></i></div>
              <div class="card-accent-bar"></div>
              <div class="module-badge">LEVER 03 &bull; LABOR ENGINEERING</div>
              <h3 class="module-title">Automation &amp; Workstation Deskilling</h3>
              <p class="module-desc">
                Targeted mechanization and low-cost intelligent automation (LCIA) that removes high-dexterity operator bottlenecks and stabilizes standard time.
              </p>
              <ul class="module-list">
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1a3f6f" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Pneumatic folding attachments for collar setting, placket folding, and pocket welting</span></li>
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1a3f6f" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Programmable pattern clamp sewers for critical decorative and structural seams</span></li>
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1a3f6f" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Automatic stackers and thread trimmers eliminating non-value handling motions</span></li>
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1a3f6f" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Rapid training matrices enabling new hires to reach target pitch efficiency in days</span></li>
              </ul>
              <div class="module-result-chip">
                <strong>Expected Impact:</strong> 20&ndash;40% SAM reduction on critical stations &amp; lower skill dependency
              </div>
            </div>
          </div>

          <!-- Module 4: Intelligent Material Logistics & Flow -->
          <div class="module-card">
            <span class="card-faded-number" aria-hidden="true">04</span>
            <div class="card-content">
              <div class="card-icon"><i class="ti ti-truck-delivery"></i></div>
              <div class="card-accent-bar"></div>
              <div class="module-badge">LEVER 04 &bull; INTERNAL LOGISTICS</div>
              <h3 class="module-title">Intelligent Material Logistics &amp; Flow</h3>
              <p class="module-desc">
                Eliminate manual bundle hauling and messy gangway WIP piles with synchronized overhead conveyors, AGVs, and vertical gravity chutes.
              </p>
              <ul class="module-list">
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1a3f6f" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Unit Production Systems (UPS) and overhead tracks routing pieces directly to needles</span></li>
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1a3f6f" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Autonomous Guided Vehicles (AGV/AMR) for roll dispatch and finished bundle transit</span></li>
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1a3f6f" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Vertical spiral chutes moving cut bundles from cutting floors to sewing gangways</span></li>
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1a3f6f" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Strict FIFO discipline ensuring zero buried orders and faster throughput velocity</span></li>
              </ul>
              <div class="module-result-chip">
                <strong>Expected Impact:</strong> 40% reduction in shop-floor WIP &amp; 25% faster dock-to-dock cycle
              </div>
            </div>
          </div>

          <!-- Module 5: Smart IE & Digital Quality Systems -->
          <div class="module-card">
            <span class="card-faded-number" aria-hidden="true">05</span>
            <div class="card-content">
              <div class="card-icon"><i class="ti ti-shield-check"></i></div>
              <div class="card-accent-bar"></div>
              <div class="module-badge">LEVER 05 &bull; QUALITY &amp; IE BALANCE</div>
              <h3 class="module-title">Smart IE &amp; Digital Quality Systems</h3>
              <p class="module-desc">
                Replaces paper quality sheets and manual stopwatches with tablet-based defect logging, instant traffic-light andons, and dynamic line balancing.
              </p>
              <ul class="module-list">
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1a3f6f" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Tablet-based end-of-line and roving DHU inspection logging defects in real time</span></li>
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1a3f6f" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Instant traffic-light alerts triggering line interventions when DHU spikes above threshold</span></li>
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1a3f6f" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Digital Yamazumi line pitch diagrams recalculating re-balance options in 15 minutes</span></li>
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1a3f6f" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Historical defect heatmaps guiding targeted operator re-training and needle maintenance</span></li>
              </ul>
              <div class="module-result-chip">
                <strong>Expected Impact:</strong> 35&ndash;50% DHU reduction &amp; 90%+ line balancing efficiency
              </div>
            </div>
          </div>

          <!-- Module 6: Enterprise Scope & Management Cockpit -->
